{
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "GitHub Actions lint",
          "version": "(devel)",
          "informationUri": "https://github.com/kjanat/actionlint",
          "rules": [
            {
              "id": "action",
              "name": "Action",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "description": "Validate action references, inputs, outputs, and local metadata",
                "queryURI": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
              },
              "fullDescription": {
                "text": "Validate action references, inputs, outputs, and local metadata"
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
            },
            {
              "id": "cache-call-unrestricted",
              "name": "CacheCallUnrestricted",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "description": "Report reusable workflow calls without explicit cache limits on low-trust triggers",
                "queryURI": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
              },
              "fullDescription": {
                "text": "Report reusable workflow calls without explicit cache limits on low-trust triggers"
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
            },
            {
              "id": "cache-operation",
              "name": "CacheOperation",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "description": "Report cache actions blocked by explicit cache access limits",
                "queryURI": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
              },
              "fullDescription": {
                "text": "Report cache actions blocked by explicit cache access limits"
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
            },
            {
              "id": "cache-write-untrusted",
              "name": "CacheWriteUntrusted",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "description": "Report cache write access granted on low-trust triggers",
                "queryURI": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
              },
              "fullDescription": {
                "text": "Report cache write access granted on low-trust triggers"
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
            },
            {
              "id": "case-insensitive-conditions",
              "name": "CaseInsensitiveConditions",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "description": "Flag case-insensitive identity comparisons",
                "queryURI": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
              },
              "fullDescription": {
                "text": "Flag case-insensitive identity comparisons"
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
            },
            {
              "id": "credentials",
              "name": "Credentials",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "description": "Detect hardcoded passwords in job and service containers",
                "queryURI": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
              },
              "fullDescription": {
                "text": "Detect hardcoded passwords in job and service containers"
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
            },
            {
              "id": "deprecated-commands",
              "name": "DeprecatedCommands",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "description": "Report deprecated set-output, save-state, set-env, and add-path commands",
                "queryURI": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
              },
              "fullDescription": {
                "text": "Report deprecated set-output, save-state, set-env, and add-path commands"
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
            },
            {
              "id": "disallow-suppressions",
              "name": "DisallowSuppressions",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "description": "Report suppressions forbidden by policy",
                "queryURI": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
              },
              "fullDescription": {
                "text": "Report suppressions forbidden by policy"
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
            },
            {
              "id": "env-var",
              "name": "EnvVar",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "description": "Validate environment variable declarations",
                "queryURI": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
              },
              "fullDescription": {
                "text": "Validate environment variable declarations"
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
            },
            {
              "id": "events",
              "name": "Events",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "description": "Validate workflow triggers and their options",
                "queryURI": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
              },
              "fullDescription": {
                "text": "Validate workflow triggers and their options"
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
            },
            {
              "id": "executable-bit",
              "name": "ExecutableBit",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "description": "Report directly invoked repository scripts not marked executable in Git",
                "queryURI": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
              },
              "fullDescription": {
                "text": "Report directly invoked repository scripts not marked executable in Git"
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
            },
            {
              "id": "expression",
              "name": "Expression",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "description": "Validate expression syntax, names, types, and context availability",
                "queryURI": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
              },
              "fullDescription": {
                "text": "Validate expression syntax, names, types, and context availability"
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
            },
            {
              "id": "glob",
              "name": "Glob",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "description": "Validate branch, tag, and path filter patterns",
                "queryURI": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
              },
              "fullDescription": {
                "text": "Validate branch, tag, and path filter patterns"
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
            },
            {
              "id": "id",
              "name": "Id",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "description": "Report invalid job or step IDs and duplicate step IDs",
                "queryURI": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
              },
              "fullDescription": {
                "text": "Report invalid job or step IDs and duplicate step IDs"
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
            },
            {
              "id": "if-cond",
              "name": "IfCond",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "description": "Report conditions that always evaluate to true or false",
                "queryURI": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
              },
              "fullDescription": {
                "text": "Report conditions that always evaluate to true or false"
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
            },
            {
              "id": "inline-suppression",
              "name": "InlineSuppression",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "description": "Validate inline suppression directives",
                "queryURI": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
              },
              "fullDescription": {
                "text": "Validate inline suppression directives"
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
            },
            {
              "id": "job-needs",
              "name": "JobNeeds",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "description": "Report undefined job dependencies and dependency cycles",
                "queryURI": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
              },
              "fullDescription": {
                "text": "Report undefined job dependencies and dependency cycles"
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
            },
            {
              "id": "matrix",
              "name": "Matrix",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "description": "Validate matrix definitions, combinations, and filters",
                "queryURI": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
              },
              "fullDescription": {
                "text": "Validate matrix definitions, combinations, and filters"
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
            },
            {
              "id": "missing-local-action",
              "name": "MissingLocalAction",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "description": "Report local action references whose manifests cannot be found",
                "queryURI": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
              },
              "fullDescription": {
                "text": "Report local action references whose manifests cannot be found"
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
            },
            {
              "id": "mixed-type-comparisons",
              "name": "MixedTypeComparisons",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "description": "Flag condition comparisons that implicitly convert scalar types",
                "queryURI": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
              },
              "fullDescription": {
                "text": "Flag condition comparisons that implicitly convert scalar types"
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
            },
            {
              "id": "mixed-type-matrix-filters",
              "name": "MixedTypeMatrixFilters",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "description": "Flag matrix filters that compare different or unknown scalar types",
                "queryURI": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
              },
              "fullDescription": {
                "text": "Flag matrix filters that compare different or unknown scalar types"
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
            },
            {
              "id": "parallel-steps",
              "name": "ParallelSteps",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "description": "Validate background-step references and restrictions within parallel groups",
                "queryURI": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
              },
              "fullDescription": {
                "text": "Validate background-step references and restrictions within parallel groups"
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
            },
            {
              "id": "permissions",
              "name": "Permissions",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "description": "Validate token permission scopes and access levels",
                "queryURI": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
              },
              "fullDescription": {
                "text": "Validate token permission scopes and access levels"
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
            },
            {
              "id": "runner-label",
              "name": "RunnerLabel",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "description": "Report unknown or incompatible runner labels",
                "queryURI": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
              },
              "fullDescription": {
                "text": "Report unknown or incompatible runner labels"
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
            },
            {
              "id": "shell-name",
              "name": "ShellName",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "description": "Validate script shells for the selected runner",
                "queryURI": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
              },
              "fullDescription": {
                "text": "Validate script shells for the selected runner"
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
            },
            {
              "id": "string-conditions",
              "name": "StringConditions",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "description": "Flag string conditions whose truthiness may be misleading",
                "queryURI": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
              },
              "fullDescription": {
                "text": "Flag string conditions whose truthiness may be misleading"
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
            },
            {
              "id": "syntax-check",
              "name": "SyntaxCheck",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "description": "Validate GitHub Actions workflow syntax",
                "queryURI": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
              },
              "fullDescription": {
                "text": "Validate GitHub Actions workflow syntax"
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
            },
            {
              "id": "unsound-ternary",
              "name": "UnsoundTernary",
              "defaultConfiguration": {"level": "error"},
              "properties": {
                "description": "Report a && b || c expressions where b is always falsy",
                "queryURI": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
              },
              "fullDescription": {"text": "Report a && b || c expressions where b is always falsy"},
              "helpUri": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
            },
            {
              "id": "workflow-call",
              "name": "WorkflowCall",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "description": "Validate reusable workflow references and their declared inputs and outputs",
                "queryURI": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
              },
              "fullDescription": {
                "text": "Validate reusable workflow references and their declared inputs and outputs"
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/HEAD/docs/checks.md"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "syntax-check",
          "message": {
            "text": "unexpected key \"branch\" for \"push\" section. expected one of \"branches\", \"branches-ignore\", \"paths\", \"paths-ignore\", \"tags\", \"tags-ignore\", \"types\", \"workflows\""
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "testdata/format/test.yaml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 3,
                  "startColumn": 5,
                  "endColumn": 11,
                  "snippet": {
                    "text": "    branch: main\n    ^~~~~~~"
                  }
                }
              }
            }
          ]
        },
        {
          "ruleId": "expression",
          "message": {
            "text": "property \"msg\" is not defined in object type {}"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "testdata/format/test.yaml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 9,
                  "startColumn": 23,
                  "endColumn": 32,
                  "snippet": {
                    "text": "      - run: echo ${{ matrix.msg }}\n                      ^~~~~~~~~~"
                  }
                }
              }
            }
          ]
        },
        {
          "ruleId": "syntax-check",
          "message": {
            "text": "unexpected key \"with\" for step to run shell command. expected one of \"background\", \"continue-on-error\", \"env\", \"id\", \"if\", \"name\", \"run\", \"shell\", \"timeout-minutes\", \"working-directory\""
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "testdata/format/test.yaml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 10,
                  "startColumn": 9,
                  "endColumn": 13,
                  "snippet": {
                    "text": "        with:\n        ^~~~~"
                  }
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
