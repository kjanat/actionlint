package kjanat:actionlint@0.1.0;

/// A plugin analyzes one document at a time. The host hands over the document and
/// the facts the plugin declared in its descriptor, and takes back diagnostics.
interface analyzer {
    record source-reference {
        document: string,
        revision: string,
        node: string,
        address: string,
    }

    record revision {
        path: string,
        digest: string,
    }

    /// One-based Unicode character position in a document. Range ends are
    /// exclusive and may lie on a later line.
    record position {
        line: u32,
        column: u32,
    }

    /// Maps the text columns [start, end) of one line of script text to the
    /// declaring document. `document` is the position of the first mapped
    /// character. `document-end` is set for a decoded escape sequence whose source
    /// width differs from its text width.
    ///
    /// To place a finding at text (line, column): find the span with that line
    /// where `start <= column < end`; the document position is
    /// `document.column + column - start` on `document.line`. For an exclusive end
    /// column use `start < column <= end` and take `document-end` when it is set
    /// and `column == end`. A zero-width span (`start == end`) matches an
    /// exclusive column equal to `start`.
    record span {
        line: u32,
        start: u32,
        end: u32,
        document: position,
        document-end: option<position>,
    }

    /// The step whose `uses:` reference reached a composite action's script.
    /// An empty `caller` means the analyzed document. `depth` counts composite
    /// calls from the analyzed document.
    record invocation {
        reference: source-reference,
        caller: string,
        step: position,
        uses: string,
        depth: u32,
    }

    /// Shell and working directory the runner would use. The `known` flags report
    /// whether static analysis determined the value. `shell-implicit` marks a
    /// shell supplied by the runner or platform rather than by a declaration.
    record runtime {
        shell: string,
        shell-known: bool,
        shell-implicit: bool,
        directory: string,
        directory-known: bool,
    }

    /// A declared run script. `shell` is the declared shell without runner
    /// defaults. `start` points to the run value in the document at `path`; an
    /// empty `path` means the analyzed document. `invocation` is set for scripts
    /// reached through a composite action call. `runtime` is set when the
    /// `execution` fact was requested.
    record script {
        reference: source-reference,
        job-id: string,
        step-id: string,
        text: string,
        shell: string,
        start: position,
        path: string,
        spans: list<span>,
        invocation: option<invocation>,
        runtime: option<runtime>,
    }

    /// Distinguishes a runtime name from a statically invalid declaration.
    enum key-state {
        unknown,
        known,
        invalid,
    }

    /// One normalized mapping key. `evaluated` entries came from object
    /// expressions and must not be interpreted again.
    record entry {
        name: string,
        state: key-state,
        source: string,
        evaluated: bool,
        start: position,
    }

    /// Normalized names and source provenance for a declaration. `complete` is
    /// false when an insertion or key depends on runtime values.
    record mapping {
        reference: source-reference,
        scope: string,
        complete: bool,
        entries: list<entry>,
    }

    /// Shared information a plugin can request.
    enum fact {
        source,
        scripts,
        mappings,
        invocations,
        execution,
        dependencies,
    }

    /// One document and its facts. `options` holds the JSON the host registered
    /// for this plugin, or an empty string. `scripts` are declared by the document
    /// itself. `invoked` scripts belong to composite actions the document calls and
    /// name their own `path`.
    record dependency {
        reference: source-reference,
        uses: string,
        kind: string,
        start: position,
        end: position,
    }

    record input {
        reference: source-reference,
        path: string,
        content: string,
        kind: string,
        parse-status: string,
        available: list<fact>,
        options: string,
        scripts: list<script>,
        invoked: list<script>,
        mappings: list<mapping>,
        dependencies: list<dependency>,
    }

    /// Replaces a half-open Unicode range in the original source file.
    record edit {
        path: string,
        start: position,
        end: position,
        replacement: string,
    }

    /// One complete suggested change. All edits apply together.
    record fix {
        applicability: string,
        revisions: list<revision>,
        description: string,
        edits: list<edit>,
    }

    record related {
        message: string,
        path: string,
        start: position,
        end: position,
    }

    /// A finding. An empty `rule` takes the plugin name; an empty `path` takes the
    /// analyzed document. `code` and `severity` carry the plugin's own identifier
    /// and level when it has them.
    record diagnostic {
        reference: option<source-reference>,
        explanation: string,
        help: string,
        documentation-url: string,
        related: list<related>,
        rule: string,
        code: string,
        severity: string,
        message: string,
        path: string,
        start: position,
        end: position,
        fixes: list<fix>,
    }

    record example {
        description: string,
        before: string,
        after: string,
    }

    /// Plugin identity and the facts it needs before any document is analyzed.
    record descriptor {
        description: string,
        category: string,
        subcategory: string,
        maturity: string,
        provider: string,
        recommended: bool,
        explanation: string,
        help: string,
        documentation-url: string,
        fix-availability: string,
        options-schema: string,
        examples: list<example>,
        name: string,
        requires: list<fact>,
    }

    describe: func() -> descriptor;

    /// Returns findings, or a message when analysis could not complete. A trap,
    /// an exit or an exceeded limit is reported by the host as a failed analysis.
    analyze: func(input: input) -> result<list<diagnostic>, string>;
}

/// Capabilities the host grants to every plugin.
interface host {
    /// Writes one diagnostic line to the host's log.
    log: func(message: string);
}

world plugin {
    import host;
    export analyzer;
}
