package kjanat:actionlint@0.3.0;

/// Optional provenance semantics for diagnostics on expression-masked snippets,
/// paired with script-engine 0.3.0. Engines classify findings semantically;
/// hosts must never infer an effect from a rule code, diagnostic message,
/// engine name, or package identity. The request and diagnostic are those of
/// script-engine 0.3.0, so a template-aware engine keeps fixes, findings in
/// files it read, excluded codes and the request directory.
interface template-effects {
    /// One-based Unicode scalar coordinates; range ends are exclusive.
    /// LF, CRLF, and lone CR delimit lines.
    record position {
        row: u32,
        column: u32,
    }

    /// Replaces the snippet text between two positions with text.
    record replacement {
        location: position,
        end-location: position,
        text: string,
    }

    /// One suggested edit. Its replacements apply together or not at all.
    record fix {
        description: string,
        replacements: list<replacement>,
    }

    /// The script-engine 0.3.0 diagnostic.
    record diagnostic {
        filename: string,
        code: string,
        name: string,
        message: string,
        severity: string,
        location: position,
        end-location: position,
        url: option<string>,
        source: option<string>,
        fixes: list<fix>,
    }

    /// The script-engine 0.3.0 request.
    record request {
        source: string,
        filename: string,
        config: string,
        excluded: list<string>,
        directory: option<string>,
    }

    enum effect {
        /// The finding is valid regardless of template substitution.
        none,
        /// Line width is uncertain when that line contains a substitution.
        line-length,
        /// Depends on a complete set of references in the snippet.
        complete-references,
        /// Targets an identifier synthesized for a substitution.
        opaque-name,
        /// Targets parentheses synthesized for a substitution.
        opaque-parentheses,
        /// Depends on the contents of a string containing a substitution.
        string-contents,
        /// Depends on the first paragraph of a docstring containing a substitution.
        docstring-summary,
        /// Targets an exported string name; the range identifies that exact name.
        exported-name,
        /// Depends on a percent conversion slot occupied by a substitution.
        percent-conversion,
    }

    /// A finding in a reported source describes a file without template
    /// substitutions; its effect is none.
    record finding {
        diagnostic: diagnostic,
        effect: effect,
    }

    record outcome {
        diagnostics: list<finding>,
        error: option<string>,
    }

    /// Returns "kjanat:actionlint/template-effects@0.1.0" exactly.
    contract: func() -> string;
    /// Replaces script-engine check for this component.
    check: func(request: request) -> outcome;
}

world template-script-engine-plugin {
    export script-engine;
    export template-effects;
}
