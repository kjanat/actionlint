package kjanat:actionlint@0.2.0;

world environment-plugin {
    include plugin;
    import kjanat:actionlint-script/environments@0.3.0;
}

world environment-annotated-plugin {
    include annotated-plugin;
    import kjanat:actionlint-script/environments@0.3.0;
}

world environment-managed-plugin {
    include managed-plugin;
    import kjanat:actionlint-script/environments@0.3.0;
}

world environment-script-engine-plugin {
    import kjanat:actionlint-script/environments@0.3.0;
    export kjanat:actionlint/script-engine@0.3.0;
}

world environment-template-script-engine-plugin {
    import kjanat:actionlint-script/environments@0.3.0;
    export kjanat:actionlint/script-engine@0.3.0;
    export kjanat:actionlint/template-effects@0.3.0;
}
