{
  "name": "@kjanat-actionlint/language-server",
  "version": "0.1.0",
  "description": "The actionlint language server for browser workers and VS Code web clients",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": "./dist/worker.js",
    "./server.wasm": "./dist/server.wasm"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "bun --bun tsdown",
    "postbuild": "bun scripts/build-wasm.ts",
    "typecheck": "tsc-rs --noEmit -p tsconfig.json",
    "pretest": "bun run build",
    "test": "playwright test",
    "prepack": "bun run build"
  },
  "dependencies": {
    "vscode-jsonrpc": "^10.0.0",
    "vscode-languageserver-protocol": "^3.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "tsdown": "^0.23.4",
    "typescript": "^7"
  }
}
