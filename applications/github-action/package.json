{
  "name": "actionlint-action",
  "version": "0.0.0",
  "private": true,
  "description": "JavaScript launcher for the actionlint GitHub Action",
  "type": "module",
  "imports": {
    "#*": "./src/*.ts",
    "#pkg": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "node --test tests/*.test.*",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@actions/cache": "6.3.0",
    "string-width": "8.3.0",
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@kjanat/actionlint": "workspace:*",
    "@types/node": ">=24",
    "tsdown": "0.23.1"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": [
      {
        "name": "bun",
        "onFail": "warn"
      }
    ],
    "runtime": [
      {
        "name": "node",
        "version": ">=24",
        "onFail": "ignore"
      }
    ]
  }
}
