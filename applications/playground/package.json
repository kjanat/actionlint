{
  "name": "actionlint-playground",
  "version": "0.0.0",
  "private": true,
  "description": "Playground for actionlint",
  "homepage": "https://actionlint.kjanat.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kjanat/actionlint.git",
    "directory": "applications/playground"
  },
  "license": "MIT",
  "type": "module",
  "imports": {
    "#pkg": "./package.json",
    "#*": "./src/*.ts"
  },
  "main": "main.js",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "run -qs lint:eslint typecheck",
    "lint:eslint": "eslint .",
    "preview": "vite preview --port 1234",
    "test": "run -s test:version test:vitest",
    "test:browser": "playwright test",
    "test:version": "node --test src/*.test.ts",
    "test:vitest": "vitest run",
    "typecheck": "tsc-rs --noEmit"
  },
  "overrides": {
    "@typescript-eslint": {
      "typescript": "<7"
    },
    "diff": "^8.0.3",
    "eslint": {
      "typescript": "<7"
    },
    "serialize-javascript": "^7.0.5"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@kjanat-actionlint/language-server": "workspace:*",
    "@kjlint/changelog-rss": "workspace:*",
    "bulma": "^1.0.4",
    "codemirror": "^6.0.2",
    "devicon": "^2.18.0",
    "ismobilejs": "^1.1.1",
    "pako": "^3.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@kjanat/rshellcheck-wasm": "1.0.0",
    "@types/node": "^26.6.6",
    "dreamcli": "npm:@kjanat/dreamcli@^5",
    "eslint": "^10.14.0",
    "jsdom": "^30.1.3",
    "runner-run": "latest",
    "typescript": "^7",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
