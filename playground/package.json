{
  "name": "actionlint-playground",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "license": "MIT",
  "author": "rhysd <lin90162@yahoo.co.jp> (https://rhysd.github.io/)",
  "main": "main.js",
  "scripts": {
    "build": "tsc -p .",
    "lint": "run -qs lint:eslint lint:tsc-eslint",
    "lint:eslint": "eslint --max-warnings 0 *.ts *.mjs",
    "lint:tsc-eslint": "tsc -p tsconfig.eslint.json",
    "serve": "http-server . -p 1234",
    "start": "npm run serve",
    "test": "mocha ./test.js",
    "typecheck": "run -q tsc7 --noEmit",
    "watch": "tsc -p . --watch"
  },
  "overrides": {
    "diff": "^8.0.3",
    "serialize-javascript": "^7.0.5"
  },
  "dependencies": {
    "bulma": "^1.0.4",
    "codemirror": "^5.65.8",
    "devicon": "^2.17.0",
    "ismobilejs": "^1.1.1",
    "pako": "^2.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@peculiar/webcrypto": "^1.5.0",
    "@types/codemirror": "^5.60.17",
    "@types/eslint-plugin-mocha": "^10.4.0",
    "@types/jsdom": "^27.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.0.3",
    "@types/pako": "^2.0.4",
    "eslint": "^9.39.2",
    "eslint-plugin-mocha": "^11.2.0",
    "http-server": "^14.1.1",
    "jsdom": "^28.0.0",
    "mocha": "^11.7.5",
    "runner-run": "^0.25.1",
    "tsc7": "npm:typescript@^7",
    "typescript": "^6",
    "typescript-eslint": "^8.50.0"
  }
}
