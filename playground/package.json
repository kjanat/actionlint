{
  "name": "actionlint-playground",
  "version": "0.0.0",
  "private": true,
  "description": "Playground for actionlint",
  "homepage": "https://actionlint.kjanat.dev",
  "repository": { "type": "git", "url": "https://github.com/kjanat/actionlint", "directory": "playground" },
  "license": "MIT",
  "author": "rhysd <lin90162@yahoo.co.jp> (https://rhysd.github.io/)",
  "maintainers": [{ "name": "Kaj Kowalski", "url": "https://github.com/kjanat" }],
  "type": "module",
  "main": "main.js",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "run -qs lint:eslint typecheck",
    "lint:eslint": "eslint .",
    "preview": "vite preview --port 1234",
    "start": "run -q dev",
    "test": "vitest run",
    "typecheck": "run -q tsc7 --noEmit"
  },
  "overrides": {
    "diff": "^8.0.3",
    "serialize-javascript": "^7.0.5"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@kjlint/changelog-rss": "^0.0.0",
    "bulma": "^1.0.4",
    "codemirror": "^6.0.2",
    "devicon": "^2.17.0",
    "ismobilejs": "^1.1.1",
    "pako": "^3.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "runner-run": "^0.27.0",
    "tsc7": "npm:typescript@^7",
    "typescript": "^6",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "volta": { "extends": "../package.json" }
}
