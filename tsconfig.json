{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": ["**/*"],
  "exclude": [
    "node_modules",
    "libraries",
    "applications/github-action",
    "plugins/sdk/typescript",
    "applications/playground",
    "**/testdata/**",
    "**/dist/**",
    "github-docs",
    "plugins/examples/external-linters",
    "plugins/examples/**/actionlint.js",
    "plugins/examples/**/actionlint.mjs"
  ],
  "references": [
    { "path": "./applications/playground/tsconfig.json" }
  ]
}
