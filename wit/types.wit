package actionlint:extension@0.1.0;

interface types {
    /// IDs belong to one request snapshot and grant no filesystem authority.
    type source-id = u64;
    record source { id: source-id, text: string }
    /// Half-open UTF-8 byte offsets in the original source text.
    record range { source: source-id, start: u32, end: u32 }
    record name { value: string, location: range }
    enum unavailable { unresolved, invalid, unsupported, cancelled, budget-exceeded }
    variant dependencies { known(list<name>), unavailable(unavailable) }
    record job { name: name, needs: dependencies }
    variant jobs { known(list<job>), unavailable(unavailable) }
    /// Exact segments copy source bytes; transformed segments identify the source
    /// construct that produced their text. Generated segments have no source range.
    variant origin { exact(range), transformed(range), generated }
    record text-segment { text: string, origin: origin }
    enum expression-kind { delimited, bare-condition, unterminated }
    record expression { kind: expression-kind, location: range, text: list<text-segment> }
    record request { snapshot: u64, sources: list<source>, jobs: jobs, expressions: list<expression> }
    enum severity { error, warning, information, hint }
    record related { message: string, location: range }
    record edit { location: range, replacement: string }
    enum applicability { automatic, requires-review }
    /// Each fix is an alternative transaction; its edits must not overlap.
    record fix { title: string, applicability: applicability, edits: list<edit> }
    record diagnostic {
        rule: string, message: string, severity: severity, primary: range,
        related: list<related>, fixes: list<fix>
    }
    variant completion { complete, incomplete(list<unavailable>) }
    record analysis-result { snapshot: u64, diagnostics: list<diagnostic>, completion: completion }
    variant failure { invalid-input(string), unsupported(string), failed(string) }
}
