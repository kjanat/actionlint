{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "master"
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!!**/*.{yml,yaml}", "!!**/testdata", "!internal/model/contexts/events/payload/catalogue.json"]
  },
  "formatter": {
    "enabled": false,
  },
  "linter": {
    "includes": ["**", "!**/*.svg"],
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useLiteralKeys": "off"
      },
      "suspicious": {
        "noControlCharactersInRegex": "off",
        "noTemplateCurlyInString": "off"
      },
      "style": {
      }
    },
    "domains": {
      "project": "recommended",
      "test": "recommended",
      "types": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["internal/model/contexts/events/payload/catalogue.json"],
      "files": {
        "maxSize": 3145728
      }
    },
    {
      "includes": [
        "applications/playground/src/test.ts",
        "applications/playground/src/**/*.test.ts",
        "applications/playground/src/**/*.spec.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            // Workflow fixtures deliberately contain literal GitHub Actions expressions.
            "noTemplateCurlyInString": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ["node:assert", "node:assert/strict", "node:test", "vitest"],
              ":BLANK_LINE:",
              ":NODE:",
              ":BLANK_LINE:",
              [":PACKAGE_WITH_PROTOCOL:", ":PACKAGE:", "!:STYLE:"],
              ":BLANK_LINE:",
              ["#pkg", "#tools/**"],
              ":BLANK_LINE:",
              ":ALIAS:",
              ":BLANK_LINE:",
              [":PATH:", "!:STYLE:"],
              ":BLANK_LINE:",
              ":STYLE:"
            ]
          }
        }
      }
    }
  }
}
