{
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "columnKind": "unicodeCodePoints",
      "tool": {
        "driver": {
          "name": "GitHub Actions lint",
          "version": "(devel)",
          "informationUri": "https://github.com/kjanat/actionlint",
          "rules": [
            {
              "id": "action",
              "name": "Action",
              "defaultConfiguration": {
                "level": "error",
                "enabled": true
              },
              "properties": {
                "description": "Validate action references, inputs, outputs, and local metadata",
                "queryURI": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#action"
              },
              "fullDescription": {
                "text": "Validate action references, inputs, outputs, and local metadata."
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#action",
              "help": {
                "text": "Check the action reference, runtime, declared inputs and action metadata at the indicated source."
              }
            },
            {
              "id": "cache-call-unrestricted",
              "name": "CacheCallUnrestricted",
              "defaultConfiguration": {
                "level": "error",
                "enabled": true
              },
              "properties": {
                "description": "Report reusable workflow calls without explicit cache limits on low-trust triggers",
                "queryURI": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#cache-call-unrestricted"
              },
              "fullDescription": {
                "text": "Report reusable workflow calls reachable from low-trust triggers without an explicit cache mode. The called workflow can request cache writes despite the trigger's read-only default."
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#cache-call-unrestricted",
              "help": {
                "text": "Set cache-mode to read or none on the calling job or workflow."
              }
            },
            {
              "id": "cache-operation",
              "name": "CacheOperation",
              "defaultConfiguration": {
                "level": "error",
                "enabled": true
              },
              "properties": {
                "description": "Report cache actions blocked by explicit cache access limits",
                "queryURI": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#cache-operation"
              },
              "fullDescription": {
                "text": "Report cache save or restore operations blocked by an explicit cache mode. GitHub skips the blocked operations."
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#cache-operation",
              "help": {
                "text": "Remove the cache step or choose an action and cache mode that allow the intended operation."
              }
            },
            {
              "id": "cache-write-untrusted",
              "name": "CacheWriteUntrusted",
              "defaultConfiguration": {
                "level": "error",
                "enabled": true
              },
              "properties": {
                "description": "Report cache write access granted on low-trust triggers",
                "queryURI": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#cache-write-untrusted"
              },
              "fullDescription": {
                "text": "Report cache write access reachable from low-trust triggers. Untrusted code or input can poison caches consumed by privileged workflows."
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#cache-write-untrusted",
              "help": {
                "text": "Set cache-mode to read or none, restrict the job with an event guard, or document a reviewed exception with an inline suppression."
              }
            },
            {
              "id": "case-insensitive-conditions",
              "name": "CaseInsensitiveConditions",
              "defaultConfiguration": {
                "level": "error",
                "enabled": false
              },
              "properties": {
                "description": "Flag case-insensitive identity comparisons",
                "queryURI": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#case-insensitive-conditions"
              },
              "fullDescription": {
                "text": "Flag case-insensitive identity comparisons."
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#case-insensitive-conditions",
              "help": {
                "text": "Expression string comparisons ignore case; avoid using them as case-sensitive identity checks."
              }
            },
            {
              "id": "coercion",
              "name": "Coercion",
              "defaultConfiguration": {
                "level": "warning",
                "enabled": false
              },
              "properties": {
                "description": "Warn about surprising string and comparison coercions",
                "queryURI": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#coercion"
              },
              "fullDescription": {
                "text": "Warn when a string parameter converts a boolean or null, when a comparison mixes a collection with a type other than null, or when an ordering comparison uses booleans, null or collections. These expressions are valid in GitHub Actions. Unknown types do not establish a suspicious conversion. Collection equality within the same type is allowed because Actions compares instance identity. Equality with null is a presence check and is allowed."
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#coercion",
              "help": {
                "text": "Check the intended argument or operand type. Use a string literal when text is intended, or compare values of the intended types. This rule offers no automatic edit because the intended value is unknown."
              }
            },
            {
              "id": "collection-comparison",
              "name": "CollectionComparison",
              "defaultConfiguration": {
                "level": "error",
                "enabled": true
              },
              "properties": {
                "description": "Detect equality checks between object or array instances",
                "queryURI": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#collection-comparison"
              },
              "fullDescription": {
                "text": "Objects and arrays compare equal only when they are the same instance. Equal contents do not make separately created objects or arrays equal. A condition that grants access or gates a write can therefore evaluate differently from a comparison of contents. This check reports == and != between two known objects or two known arrays. It accepts null checks and repeated access to the same context property, and skips unknown types and expressions that cannot execute."
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#collection-comparison",
              "help": {
                "text": "Compare the fields or array elements that determine equality. Disable this rule for a deliberate instance-identity comparison."
              }
            },
            {
              "id": "container-runner",
              "name": "ContainerRunner",
              "defaultConfiguration": {
                "level": "error",
                "enabled": true
              },
              "properties": {
                "description": "Report Docker container requirements for selected runners",
                "queryURI": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#container-runner"
              },
              "fullDescription": {
                "text": "GitHub-managed job containers, service containers and Docker actions require Linux and a Docker daemon. Report an error for known Windows or macOS selections. Warn for GitHub-hosted ubuntu-slim: it includes Docker client tools but no local daemon; a compatible remote daemon may satisfy the requirement. Inspect available action metadata and expanded composites, with matrix rows and conditions determining which selections can reach the container. Unknown runner facts and unavailable action bodies do not establish a violation. Docker commands in scripts can use remote daemons and are not classified by this rule."
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#container-runner",
              "help": {
                "text": "Select a Linux runner with Docker, such as ubuntu-latest, or guard the container action so incompatible matrix rows do not execute it. For ubuntu-slim, verify any remote daemon configuration before suppressing the warning. Self-hosted Linux runners need an accessible Docker daemon. No automatic fix is offered because changing the runner can change job behavior."
              }
            },
            {
              "id": "context-availability",
              "name": "ContextAvailability",
              "defaultConfiguration": {
                "level": "error",
                "enabled": true
              },
              "properties": {
                "description": "Validate contexts and functions available at a workflow field",
                "queryURI": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#context-availability"
              },
              "fullDescription": {
                "text": "Validate contexts and functions available at a workflow field."
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#context-availability",
              "help": {
                "text": "Move the expression to a field where its contexts and functions are available, or use an available value."
              }
            },
            {
              "id": "credentials",
              "name": "Credentials",
              "defaultConfiguration": {
                "level": "error",
                "enabled": true
              },
              "properties": {
                "description": "Detect hardcoded passwords in job and service containers",
                "queryURI": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#credentials"
              },
              "fullDescription": {
                "text": "Detect hardcoded passwords in job and service containers."
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#credentials",
              "help": {
                "text": "Store the credential as a secret and reference it through the secrets context."
              }
            },
            {
              "id": "deprecated-commands",
              "name": "DeprecatedCommands",
              "defaultConfiguration": {
                "level": "error",
                "enabled": true
              },
              "properties": {
                "description": "Report deprecated set-output, save-state, set-env, and add-path commands",
                "queryURI": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#deprecated-commands"
              },
              "fullDescription": {
                "text": "Report deprecated set-output, save-state, set-env, and add-path commands."
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#deprecated-commands",
              "help": {
                "text": "Write values to the corresponding quoted GITHUB_OUTPUT, GITHUB_STATE, GITHUB_ENV or GITHUB_PATH file."
              }
            },
            {
              "id": "empty-job",
              "name": "EmptyJob",
              "defaultConfiguration": {
                "level": "error",
                "enabled": true
              },
              "properties": {
                "description": "Report jobs without steps",
                "queryURI": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#empty-job"
              },
              "fullDescription": {
                "text": "Report jobs that run no steps. GitHub accepts the job, but it does nothing."
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#empty-job",
              "help": {
                "text": "Add the steps the job should run, or remove the job."
              }
            },
            {
              "id": "empty-run",
              "name": "EmptyRun",
              "defaultConfiguration": {
                "level": "error",
                "enabled": true
              },
              "properties": {
                "description": "Report steps with an empty run script",
                "queryURI": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#empty-run"
              },
              "fullDescription": {
                "text": "Report run steps whose script is empty. GitHub accepts the step, but it runs nothing."
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#empty-run",
              "help": {
                "text": "Write the commands the step should run, or remove the step."
              }
            },
            {
              "id": "empty-triggers",
              "name": "EmptyTriggers",
              "defaultConfiguration": {
                "level": "error",
                "enabled": true
              },
              "properties": {
                "description": "Report workflows that declare no triggers",
                "queryURI": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#empty-triggers"
              },
              "fullDescription": {
                "text": "Report workflows whose on section is empty. GitHub accepts the workflow, but no event ever starts it."
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#empty-triggers",
              "help": {
                "text": "Add the events that should start the workflow, or delete the workflow."
              }
            },
            {
              "id": "env-var",
              "name": "EnvVar",
              "defaultConfiguration": {
                "level": "error",
                "enabled": true
              },
              "properties": {
                "description": "Validate environment variable declarations",
                "queryURI": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#env-var"
              },
              "fullDescription": {
                "text": "Validate environment variable declarations."
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#env-var",
              "help": {
                "text": "Use valid environment variable names and values in the indicated mapping."
              }
            },
            {
              "id": "errexit-status",
              "name": "ErrexitStatus",
              "defaultConfiguration": {
                "level": "warning",
                "enabled": false
              },
              "properties": {
                "description": "Report Bash status reads that cannot capture a preceding failure",
                "queryURI": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#errexit-status"
              },
              "fullDescription": {
                "text": "With Bash errexit enabled, a failing simple command exits before a following $? read. The read can capture success, but cannot capture the preceding failure.\n\nThe check uses registered interpreter options and follows literal set changes, groups, subshells and known branches. This warning is opt-in because a success-only read can be intentional.\n\nThe check excludes reads within condition tests, AND/OR lists and pipelines, and reads of compound-command results. It skips trap bodies, function bodies and command substitutions. Unknown option values suspend analysis until a known set change. Operations that may replace builtins or install traps stop further analysis in that scope.\n\nThe rule is experimental because function calls, command substitution inheritance and dynamic option effects are not modeled. Bash behavior is specified at https://www.gnu.org/software/bash/manual/html_node/The-Set-Builtin.html; runner defaults are in actions/runner ScriptHandlerHelpers.cs."
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#errexit-status",
              "help": {
                "text": "Capture the failure status in an if condition or an || handler when the script must continue after failure."
              }
            },
            {
              "id": "event-payload",
              "name": "EventPayload",
              "defaultConfiguration": {
                "level": "error",
                "enabled": true
              },
              "properties": {
                "description": "Validate properties against the configured event payloads",
                "queryURI": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#event-payload"
              },
              "fullDescription": {
                "text": "Validate properties against the configured event payloads."
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#event-payload",
              "help": {
                "text": "Use a property supplied by the declared events and activity types. Unknown events and dynamic payload maps remain open."
              }
            },
            {
              "id": "events",
              "name": "Events",
              "defaultConfiguration": {
                "level": "error",
                "enabled": true
              },
              "properties": {
                "description": "Validate workflow triggers and their options",
                "queryURI": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#events"
              },
              "fullDescription": {
                "text": "Validate workflow triggers and their options."
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#events",
              "help": {
                "text": "Check the trigger name, activity type and filters at the reported location."
              }
            },
            {
              "id": "executable-bit",
              "name": "ExecutableBit",
              "defaultConfiguration": {
                "level": "error",
                "enabled": true
              },
              "properties": {
                "description": "Report directly invoked repository scripts not marked executable in Git",
                "queryURI": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#executable-bit"
              },
              "fullDescription": {
                "text": "Report directly invoked repository scripts not marked executable in Git."
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#executable-bit",
              "help": {
                "text": "Record the executable bit for the referenced script in Git, or invoke it explicitly through its interpreter."
              }
            },
            {
              "id": "expression",
              "name": "Expression",
              "defaultConfiguration": {
                "level": "error",
                "enabled": true
              },
              "properties": {
                "description": "Validate expression values assigned to workflow fields",
                "queryURI": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#expression"
              },
              "fullDescription": {
                "text": "Validate expression values assigned to workflow fields."
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#expression",
              "help": {
                "text": "Use the expression value and interpolation form required by this workflow field. Syntax, references, context availability, calls, operand types, payload properties and script injection have separate rules."
              }
            },
            {
              "id": "expression-call",
              "name": "ExpressionCall",
              "defaultConfiguration": {
                "level": "error",
                "enabled": true
              },
              "properties": {
                "description": "Validate function invocation and constant arguments",
                "queryURI": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#expression-call"
              },
              "fullDescription": {
                "text": "Validate function invocation and constant arguments."
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#expression-call",
              "help": {
                "text": "Check parentheses, argument count, format placeholders and literal JSON."
              }
            },
            {
              "id": "expression-reference",
              "name": "ExpressionReference",
              "defaultConfiguration": {
                "level": "error",
                "enabled": true
              },
              "properties": {
                "description": "Resolve expression variables, properties and functions",
                "queryURI": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#expression-reference"
              },
              "fullDescription": {
                "text": "Resolve expression variables, properties and functions."
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#expression-reference",
              "help": {
                "text": "Use a declared context, property or function; check the suggested spelling and available names."
              }
            },
            {
              "id": "expression-syntax",
              "name": "ExpressionSyntax",
              "defaultConfiguration": {
                "level": "error",
                "enabled": true
              },
              "properties": {
                "description": "Parse expression tokens and grammar",
                "queryURI": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#expression-syntax"
              },
              "fullDescription": {
                "text": "Parse expression tokens and grammar."
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#expression-syntax",
              "help": {
                "text": "Correct the indicated expression token, literal or delimiter."
              }
            },
            {
              "id": "expression-type",
              "name": "ExpressionType",
              "defaultConfiguration": {
                "level": "error",
                "enabled": true
              },
              "properties": {
                "description": "Validate expression operand and argument types",
                "queryURI": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#expression-type"
              },
              "fullDescription": {
                "text": "Validate expression operand and argument types."
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#expression-type",
              "help": {
                "text": "Supply the expected value type; convert serialized values explicitly when needed."
              }
            },
            {
              "id": "forbidden-suppression",
              "name": "ForbiddenSuppression",
              "defaultConfiguration": {
                "level": "error",
                "enabled": false
              },
              "properties": {
                "description": "Report suppressions forbidden by policy",
                "queryURI": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#forbidden-suppression"
              },
              "fullDescription": {
                "text": "Report suppressions forbidden by policy."
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#forbidden-suppression",
              "help": {
                "text": "Remove the suppression and address its finding, or change the repository suppression policy."
              }
            },
            {
              "id": "glob",
              "name": "Glob",
              "defaultConfiguration": {
                "level": "error",
                "enabled": true
              },
              "properties": {
                "description": "Validate branch, tag, and path filter patterns",
                "queryURI": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#glob"
              },
              "fullDescription": {
                "text": "Validate branch, tag, and path filter patterns."
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#glob",
              "help": {
                "text": "Correct the pattern syntax and check how positive and negative patterns are ordered."
              }
            },
            {
              "id": "id",
              "name": "Id",
              "defaultConfiguration": {
                "level": "error",
                "enabled": true
              },
              "properties": {
                "description": "Report invalid job or step IDs and duplicate step IDs",
                "queryURI": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#id"
              },
              "fullDescription": {
                "text": "Report invalid job or step IDs and duplicate step IDs."
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#id",
              "help": {
                "text": "Use a unique valid identifier within its job or workflow scope."
              }
            },
            {
              "id": "if-cond",
              "name": "IfCond",
              "defaultConfiguration": {
                "level": "error",
                "enabled": true
              },
              "properties": {
                "description": "Report conditions that always evaluate to true or false",
                "queryURI": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#if-cond"
              },
              "fullDescription": {
                "text": "Report conditions that always evaluate to true or false."
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#if-cond",
              "help": {
                "text": "Correct the expression to test the intended runtime value. Remove a condition that is always true if it is unnecessary."
              }
            },
            {
              "id": "inline-suppression",
              "name": "InlineSuppression",
              "defaultConfiguration": {
                "level": "error",
                "enabled": true
              },
              "properties": {
                "description": "Validate inline suppression directives",
                "queryURI": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#inline-suppression"
              },
              "fullDescription": {
                "text": "Validate inline suppression directives."
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#inline-suppression",
              "help": {
                "text": "Use a known rule name and place the directive on the declaration it is intended to suppress."
              }
            },
            {
              "id": "invalid-output-file",
              "name": "InvalidOutputFile",
              "defaultConfiguration": {
                "level": "error",
                "enabled": true
              },
              "properties": {
                "description": "Check literal writes to GITHUB_OUTPUT",
                "queryURI": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#invalid-output-file"
              },
              "fullDescription": {
                "text": "GITHUB_OUTPUT requires NAME=value records or multiline records enclosed by NAME\u003c\u003cdelimiter and a matching delimiter. This check combines literal writes from Bash and sh scripts, then validates the complete file. It handles literal echo and printf commands, command groups, and cat or tee with literal text from a here-document or pipe. It skips the script if it contains dynamic values, unsupported commands, variable assignments or control flow. Commands that could redefine these utilities also cause the script to be skipped."
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#invalid-output-file",
              "help": {
                "text": "Write NAME=value for a single-line output. For a multiline output, write NAME\u003c\u003cdelimiter, the value, and the matching delimiter."
              }
            },
            {
              "id": "job-needs",
              "name": "JobNeeds",
              "defaultConfiguration": {
                "level": "error",
                "enabled": true
              },
              "properties": {
                "description": "Report undefined job dependencies and dependency cycles",
                "queryURI": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#job-needs"
              },
              "fullDescription": {
                "text": "Report undefined job dependencies and dependency cycles."
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#job-needs",
              "help": {
                "text": "Reference an existing job ID and remove dependency cycles."
              }
            },
            {
              "id": "join-literal",
              "name": "JoinLiteral",
              "defaultConfiguration": {
                "level": "note",
                "enabled": false
              },
              "properties": {
                "description": "Report redundant join calls on string literals",
                "queryURI": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#join-literal"
              },
              "fullDescription": {
                "text": "join() accepts a string and returns it unchanged. Context names inside the quotes are literal text and are not evaluated. The separator has no effect on that string. This optional check reports a string literal as the first argument even when the call may be deliberate. Arrays and strings supplied by other expressions are not reported."
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#join-literal",
              "help": {
                "text": "If you meant to use literal text, remove the redundant call. To combine expression values, use format() or pass an array to join(). This rule does not offer an automatic edit."
              }
            },
            {
              "id": "matrix",
              "name": "Matrix",
              "defaultConfiguration": {
                "level": "error",
                "enabled": true
              },
              "properties": {
                "description": "Validate matrix definitions, combinations, and filters",
                "queryURI": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#matrix"
              },
              "fullDescription": {
                "text": "Validate matrix definitions, combinations, and filters."
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#matrix",
              "help": {
                "text": "Check axis names and values and ensure include/exclude entries match the intended combinations."
              }
            },
            {
              "id": "missing-local-action",
              "name": "MissingLocalAction",
              "defaultConfiguration": {
                "level": "error",
                "enabled": true
              },
              "properties": {
                "description": "Report local action references that cannot be resolved",
                "queryURI": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#missing-local-action"
              },
              "fullDescription": {
                "text": "Report local action references with no manifest or Dockerfile, a missing directory, or an ambiguous path under case-insensitive lookup."
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#missing-local-action",
              "help": {
                "text": "Check the uses path and ensure the action has a manifest or Dockerfile. If paths differ only in casing, rename them so each path can be resolved unambiguously."
              }
            },
            {
              "id": "missing-permissions",
              "name": "MissingPermissions",
              "defaultConfiguration": {
                "level": "error",
                "enabled": true
              },
              "properties": {
                "description": "Report missing token permission declarations",
                "queryURI": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#missing-permissions"
              },
              "fullDescription": {
                "text": "Report jobs with no permissions declared on the job or workflow. Set require-at to workflow or every-job to require permissions there. An array requires permissions at every listed location. When require-at is omitted, workflows triggered only by workflow_call are skipped. The workflow-call rule compares the caller's permissions with those requested by the called workflow."
              },
              "helpUri": "https://github.com/kjanat/actionlint/blob/master/docs/rules.md#missing-permissions",
              "help": {
                "text": "Add permissions on the workflow or on every job. If require-at is configured, add permissions at every location it lists. Use permissions: {} to grant none. See [CodeQL's explanation of missing workflow permissions](https://codeql.github.com/codeql-query-help/actions/actions-missing-workflow-permissions/). Set the rule to off to disable it."
              }
            },
