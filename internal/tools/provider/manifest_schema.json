{
  "$id": "https://actionlint.kjanat.dev/schemas/tool-provider-manifest-1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "digest",
        "filename",
        "platform",
        "size"
      ],
      "properties": {
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "filename": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,255}$",
          "not": {
            "enum": [
              ".",
              ".."
            ]
          }
        },
        "media_type": {
          "$ref": "#/$defs/token"
        },
        "platform": {
          "type": "string",
          "pattern": "^[a-z0-9]+/[a-z0-9]+$"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "required": [
        "fixes",
        "reported_sources"
      ],
      "properties": {
        "fixes": {
          "type": "boolean"
        },
        "message_template": {
          "$ref": "#/$defs/text",
          "minLength": 1
        },
        "reported_sources": {
          "type": "boolean"
        },
        "resources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "workspace",
              "directory"
            ]
          }
        },
        "severities": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "$ref": "#/$defs/severity"
          },
          "propertyNames": {
            "$ref": "#/$defs/token"
          }
        },
        "template_contract": {
          "$ref": "#/$defs/token"
        }
      },
      "additionalProperties": false
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "launcher": {
      "type": "object",
      "required": [
        "command",
        "hint"
      ],
      "properties": {
        "assignments": {
          "type": "boolean"
        },
        "choices": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "$ref": "#/$defs/strings",
            "minItems": 1
          },
          "propertyNames": {
            "$ref": "#/$defs/option"
          }
        },
        "command": {
          "$ref": "#/$defs/pattern"
        },
        "flags": {
          "$ref": "#/$defs/options"
        },
        "hint": {
          "$ref": "#/$defs/text",
          "minLength": 1
        },
        "module": {
          "type": "object",
          "required": [
            "name",
            "short"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/token"
            },
            "short": {
              "$ref": "#/$defs/short_letter"
            }
          },
          "additionalProperties": false
        },
        "protected": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "selector": {
          "$ref": "#/$defs/pattern"
        },
        "separator": {
          "type": "boolean"
        },
        "short_flags": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]*$"
        },
        "short_values": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]*$"
        },
        "tool": {
          "$ref": "#/$defs/pattern"
        },
        "value_options": {
          "$ref": "#/$defs/options"
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "tool"
          ]
        },
        {
          "required": [
            "module"
          ]
        }
      ]
    },
    "long_option": {
      "type": "string",
      "pattern": "^--[A-Za-z0-9][A-Za-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "option": {
      "type": "string",
      "pattern": "^--?[A-Za-z0-9][A-Za-z0-9-]*$"
    },
    "options": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/option"
      }
    },
    "pattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "placeholder": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(?:[^{}]*|\\{var:[a-z][a-z0-9_]*\\}|\\{flag:[a-z][a-z0-9_]*:-[^:{}]+\\}|\\{option:[a-z][a-z0-9_]*:-[^:{}=]+\\}|\\{switch:[a-z][a-z0-9_]*:(?:-[^:{}]+)?:(?:-[^:{}]+)?\\}|\\{list:[a-z][a-z0-9_]*:[^{}]+\\}|\\{config:toml-pairs:-[^:{}]+\\}|\\{config:(?:toml|json)-file\\}|\\{user-args\\})$"
    },
    "process": {
      "type": "object",
      "required": [
        "args",
        "config",
        "entry",
        "output",
        "stdin"
      ],
      "properties": {
        "args": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/placeholder"
          }
        },
        "concurrency": {
          "enum": [
            "pool",
            "serial"
          ]
        },
        "config": {
          "type": "object",
          "required": [
            "render"
          ],
          "properties": {
            "forbidden": {
              "$ref": "#/$defs/strings"
            },
            "render": {
              "enum": [
                "none",
                "json-file",
                "toml-file",
                "toml-pairs",
                "json-stdin"
              ]
            },
            "transform": {
              "$ref": "#/$defs/transform"
            }
          },
          "additionalProperties": false
        },
        "config_files": {
          "type": "object",
          "required": [
            "names"
          ],
          "properties": {
            "names": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]{1,255}$",
                "not": {
                  "enum": [
                    ".",
                    ".."
                  ]
                }
              }
            },
            "search": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "upward",
                  "xdg",
                  "home"
                ]
              }
            }
          },
          "additionalProperties": false
        },
        "config_schema": {
          "type": [
            "boolean",
            "object"
          ]
        },
        "entry": {
          "$ref": "#/$defs/token"
        },
        "env": {
          "type": "object",
          "maxProperties": 256,
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096
          },
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "env_passthrough": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "env_unset": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "exit_codes": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "output": {
          "type": "object",
          "required": [
            "format"
          ],
          "properties": {
            "coordinates": {
              "type": "object",
              "required": [
                "columns",
                "end",
                "rows"
              ],
              "properties": {
                "columns": {
                  "enum": [
                    "chars",
                    "bytes",
                    "utf16"
                  ]
                },
                "end": {
                  "enum": [
                    "exclusive",
                    "inclusive"
                  ]
                },
                "rows": {
                  "enum": [
                    "lf",
                    "source"
                  ]
                }
              },
              "additionalProperties": false
            },
            "format": {
              "enum": [
                "script-diagnostics@1",
                "sarif@2.1.0",
                "json",
                "text"
              ]
            },
            "transform": {
              "$ref": "#/$defs/transform"
            }
          },
          "additionalProperties": false,
          "if": {
            "properties": {
              "format": {
                "enum": [
                  "json",
                  "text"
                ]
              }
            }
          },
          "then": {
            "required": [
              "transform"
            ]
          },
          "else": {
            "not": {
              "required": [
                "transform"
              ]
            }
          }
        },
        "stdin": {
          "enum": [
            "source",
            "request"
          ]
        },
        "template_effects": {
          "type": "object",
          "maxProperties": 4096,
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "$ref": "#/$defs/token"
          }
        },
        "user_args": {
          "type": "object",
          "required": [
            "operands"
          ],
          "properties": {
            "attached_shorts": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]*$"
            },
            "env_options": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              }
            },
            "forbidden": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "type": "object",
                "required": [
                  "reason"
                ],
                "properties": {
                  "flag": {
                    "$ref": "#/$defs/long_option"
                  },
                  "prefix": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "reason": {
                    "$ref": "#/$defs/text",
                    "minLength": 1
                  },
                  "short_letter": {
                    "$ref": "#/$defs/short_letter"
                  }
                },
                "additionalProperties": false,
                "oneOf": [
                  {
                    "required": [
                      "flag"
                    ]
                  },
                  {
                    "required": [
                      "prefix"
                    ]
                  },
                  {
                    "required": [
                      "short_letter"
                    ]
                  }
                ]
              }
            },
            "inline_options": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/long_option"
              }
            },
            "launchers": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/launcher"
              }
            },
            "operands": {
              "type": "boolean"
            },
            "overrides": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "required": [
                  "drops",
                  "flag"
                ],
                "properties": {
                  "drops": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "flag": {
                    "$ref": "#/$defs/long_option"
                  },
                  "short": {
                    "$ref": "#/$defs/short_letter"
                  }
                },
                "additionalProperties": false
              }
            },
            "value_options": {
              "type": "array",
              "maxItems": 256,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/long_option"
              }
            },
            "value_shorts": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]*$"
            }
          },
          "additionalProperties": false
        },
        "version": {
          "type": "object",
          "required": [
            "args",
            "pattern"
          ],
          "properties": {
            "args": {
              "$ref": "#/$defs/strings"
            },
            "minimum": {
              "$ref": "#/$defs/token"
            },
            "pattern": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "template_effects": {
              "$ref": "#/$defs/token"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": [
        "category",
        "description",
        "maturity",
        "name",
        "provider",
        "subcategory"
      ],
      "properties": {
        "category": {
          "$ref": "#/$defs/name"
        },
        "description": {
          "$ref": "#/$defs/text",
          "minLength": 1
        },
        "documentation_url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https://"
        },
        "examples": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "after",
              "before",
              "description"
            ],
            "properties": {
              "after": {
                "type": "string",
                "maxLength": 65536
              },
              "before": {
                "type": "string",
                "maxLength": 65536
              },
              "description": {
                "$ref": "#/$defs/text"
              }
            },
            "additionalProperties": false
          }
        },
        "explanation": {
          "$ref": "#/$defs/text"
        },
        "fix_availability": {
          "$ref": "#/$defs/name"
        },
        "help": {
          "$ref": "#/$defs/text"
        },
        "maturity": {
          "$ref": "#/$defs/name"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "options_schema": {
          "type": [
            "boolean",
            "object"
          ]
        },
        "provider": {
          "$ref": "#/$defs/token"
        },
        "recommended": {
          "type": "boolean"
        },
        "subcategory": {
          "$ref": "#/$defs/name"
        }
      },
      "additionalProperties": false
    },
    "selectors": {
      "type": "object",
      "properties": {
        "filename": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,255}$",
          "not": {
            "enum": [
              ".",
              ".."
            ]
          }
        },
        "inputs": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "required": [
              "action",
              "input",
              "language"
            ],
            "properties": {
              "action": {
                "type": "string"
              },
              "input": {
                "type": "string"
              },
              "language": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "shells": {
          "$ref": "#/$defs/strings"
        }
      },
      "additionalProperties": false
    },
    "severity": {
      "enum": [
        "error",
        "warning",
        "info"
      ]
    },
    "short_letter": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]$"
    },
    "strings": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/token"
      }
    },
    "text": {
      "type": "string",
      "maxLength": 4096
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\s\\x00-\\x1f]+$"
    },
    "transform": {
      "type": "object",
      "required": [
        "language"
      ],
      "properties": {
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "inline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "language": {
          "const": "jq"
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "digest"
          ]
        },
        {
          "required": [
            "inline"
          ]
        }
      ]
    }
  },
  "title": "actionlint tool provider manifest",
  "type": "object",
  "required": [
    "capabilities",
    "id",
    "preparation",
    "role",
    "rule",
    "schema_version",
    "scope",
    "selectors",
    "transport",
    "version"
  ],
  "properties": {
    "artifacts": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "capabilities": {
      "$ref": "#/$defs/capabilities"
    },
    "config_schema": {
      "type": [
        "boolean",
        "object"
      ]
    },
    "config_shorthands": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {
        "type": "object",
        "required": [
          "path",
          "precedence"
        ],
        "properties": {
          "path": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "$ref": "#/$defs/token"
            }
          },
          "precedence": {
            "enum": [
              "shorthand",
              "config"
            ]
          }
        },
        "additionalProperties": false
      },
      "propertyNames": {
        "$ref": "#/$defs/token"
      }
    },
    "deprecated_flags": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "name",
          "value"
        ],
        "properties": {
          "arguments": {
            "$ref": "#/$defs/strings"
          },
          "name": {
            "$ref": "#/$defs/name"
          },
          "value": {
            "enum": [
              "command",
              "ignored"
            ]
          }
        },
        "additionalProperties": false,
        "if": {
          "properties": {
            "value": {
              "const": "command"
            }
          }
        },
        "then": {
          "not": {
            "required": [
              "arguments"
            ]
          }
        }
      }
    },
    "id": {
      "$ref": "#/$defs/token"
    },
    "integration": {
      "type": "object",
      "required": [
        "contract",
        "tool"
      ],
      "properties": {
        "contract": {
          "$ref": "#/$defs/token"
        },
        "tool": {
          "$ref": "#/$defs/name"
        }
      },
      "additionalProperties": false
    },
    "preparation": {
      "$ref": "#/$defs/token"
    },
    "process": {
      "$ref": "#/$defs/process"
    },
    "role": {
      "enum": [
        "script",
        "document",
        "runner"
      ]
    },
    "rule": {
      "$ref": "#/$defs/rule"
    },
    "schema_version": {
      "const": 1
    },
    "scope": {
      "enum": [
        "source",
        "composite"
      ]
    },
    "selectors": {
      "$ref": "#/$defs/selectors"
    },
    "transport": {
      "enum": [
        "process",
        "wasm-core",
        "wasm-component",
        "embedded"
      ]
    },
    "version": {
      "$ref": "#/$defs/token"
    }
  },
  "additionalProperties": false,
  "if": {
    "properties": {
      "transport": {
        "const": "process"
      }
    }
  },
  "then": {
    "required": [
      "process"
    ]
  },
  "else": {
    "not": {
      "required": [
        "process"
      ]
    }
  }
}
