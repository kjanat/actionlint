{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actionlint.kjanat.dev/schemas/tool-provider-transform-result-1.json",
  "title": "actionlint tool provider transform result",
  "oneOf": [
    { "$ref": "#/$defs/diagnostics" },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["diagnostics"],
      "properties": {
        "diagnostics": { "$ref": "#/$defs/diagnostics" },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/nonempty" } },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/nonempty" } }
      }
    }
  ],
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "line": { "type": "integer", "minimum": 1 },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row", "column"],
      "properties": {
        "row": { "$ref": "#/$defs/line" },
        "column": { "$ref": "#/$defs/line" }
      }
    },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "code", "message", "location"],
      "properties": {
        "filename": { "$ref": "#/$defs/nonempty" },
        "code": { "$ref": "#/$defs/nonempty" },
        "name": { "type": "string" },
        "message": { "$ref": "#/$defs/nonempty" },
        "severity": { "$ref": "#/$defs/nonempty" },
        "location": { "$ref": "#/$defs/position" },
        "end_location": { "$ref": "#/$defs/position" },
        "url": { "type": "string" },
        "source": { "$ref": "#/$defs/nonempty" },
        "fixes": { "type": "array", "items": { "$ref": "#/$defs/fix" } }
      }
    },
    "fix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replacements"],
      "properties": {
        "description": { "type": "string" },
        "replacements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["row", "end_row", "column", "end_column", "text"],
            "properties": {
              "row": { "$ref": "#/$defs/line" },
              "end_row": { "$ref": "#/$defs/line" },
              "column": { "$ref": "#/$defs/line" },
              "end_column": { "$ref": "#/$defs/line" },
              "text": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
