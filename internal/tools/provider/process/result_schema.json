{
  "$id": "https://actionlint.kjanat.dev/schemas/tool-provider-transform-result-1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "diagnostic": {
      "type": "object",
      "required": [
        "code",
        "filename",
        "location",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/nonempty"
        },
        "end_location": {
          "$ref": "#/$defs/position"
        },
        "filename": {
          "$ref": "#/$defs/nonempty"
        },
        "fixes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fix"
          }
        },
        "location": {
          "$ref": "#/$defs/position"
        },
        "message": {
          "$ref": "#/$defs/nonempty"
        },
        "name": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/nonempty"
        },
        "source": {
          "$ref": "#/$defs/nonempty"
        },
        "url": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "fix": {
      "type": "object",
      "required": [
        "replacements"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "replacements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "column",
              "end_column",
              "end_row",
              "row",
              "text"
            ],
            "properties": {
              "column": {
                "$ref": "#/$defs/line"
              },
              "end_column": {
                "$ref": "#/$defs/line"
              },
              "end_row": {
                "$ref": "#/$defs/line"
              },
              "row": {
                "$ref": "#/$defs/line"
              },
              "text": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "line": {
      "type": "integer",
      "minimum": 1
    },
    "nonempty": {
      "type": "string",
      "minLength": 1
    },
    "position": {
      "type": "object",
      "required": [
        "column",
        "row"
      ],
      "properties": {
        "column": {
          "$ref": "#/$defs/line"
        },
        "row": {
          "$ref": "#/$defs/line"
        }
      },
      "additionalProperties": false
    }
  },
  "title": "actionlint tool provider transform result",
  "oneOf": [
    {
      "$ref": "#/$defs/diagnostics"
    },
    {
      "type": "object",
      "required": [
        "diagnostics"
      ],
      "properties": {
        "diagnostics": {
          "$ref": "#/$defs/diagnostics"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonempty"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonempty"
          }
        }
      },
      "additionalProperties": false
    }
  ]
}
