(component
  (core module $destructor
    (func (export "drop") (param $rep i32)
      (if (i32.eqz (local.get $rep))
        (then unreachable)
        (else (loop $forever (br $forever))))))
  (core instance $d (instantiate $destructor))
  (type $resource (resource (rep i32) (dtor (core func $d "drop"))))
  (core func $new (canon resource.new $resource))
  (core instance $resource-api (export "new" (func $new)))
  (core module $m
    (import "resource" "new" (func $new (param i32) (result i32)))
    (memory (export "memory") 1)
    (data (i32.const 32) "close-fixture")
    (func $describe (export "describe") (result i32)
      ;; The canonical descriptor has zero-valued metadata before name at offset 92.
      (i32.store (i32.const 156) (i32.const 32))
      (i32.store (i32.const 160) (i32.const 13))
      (i32.const 64))
    (func (export "trap") (result i32)
      (drop (call $new (i32.const 0)))
      (call $describe))
    (func (export "hang") (result i32)
      (drop (call $new (i32.const 1)))
      (call $describe))
    (func (export "realloc") (param i32 i32 i32 i32) (result i32)
      (i32.const 1024))
    (func (export "analyze") (param i32) (result i32)
      (i32.const 256)))
  (core instance $i (instantiate $m (with "resource" (instance $resource-api))))
  (type $source-reference (record (field "document" string) (field "revision" string) (field "node" string) (field "address" string)))
  (type $revision (record (field "path" string) (field "digest" string)))
  (type $position (record (field "line" u32) (field "column" u32)))
  (type $optional-position (option $position))
  (type $span (record (field "line" u32) (field "start" u32) (field "end" u32) (field "document" $position) (field "document-end" $optional-position)))
  (type $invocation (record (field "reference" $source-reference) (field "caller" string) (field "step" $position) (field "uses" string) (field "depth" u32)))
  (type $runtime (record (field "shell" string) (field "shell-known" bool) (field "shell-implicit" bool) (field "directory" string) (field "directory-known" bool)))
  (type $spans (list $span))
  (type $optional-invocation (option $invocation))
  (type $optional-runtime (option $runtime))
  (type $script (record (field "reference" $source-reference) (field "job-id" string) (field "step-id" string) (field "text" string) (field "shell" string) (field "start" $position) (field "path" string) (field "spans" $spans) (field "invocation" $optional-invocation) (field "runtime" $optional-runtime)))
  (type $key-state (enum "unknown" "known" "invalid"))
  (type $entry (record (field "name" string) (field "state" $key-state) (field "source" string) (field "evaluated" bool) (field "start" $position)))
  (type $entries (list $entry))
  (type $mapping (record (field "reference" $source-reference) (field "scope" string) (field "complete" bool) (field "entries" $entries)))
  (type $fact (enum "source" "scripts" "mappings" "invocations" "execution" "dependencies"))
  (type $dependency (record (field "reference" $source-reference) (field "uses" string) (field "kind" string) (field "start" $position) (field "end" $position)))
  (type $facts (list $fact))
  (type $scripts (list $script))
  (type $mappings (list $mapping))
  (type $dependencies (list $dependency))
  (type $input (record (field "reference" $source-reference) (field "path" string) (field "content" string) (field "kind" string) (field "parse-status" string) (field "available" $facts) (field "options" string) (field "scripts" $scripts) (field "invoked" $scripts) (field "mappings" $mappings) (field "dependencies" $dependencies)))
  (type $edit (record (field "path" string) (field "start" $position) (field "end" $position) (field "replacement" string)))
  (type $revisions (list $revision))
  (type $edits (list $edit))
  (type $fix (record (field "applicability" string) (field "revisions" $revisions) (field "description" string) (field "edits" $edits)))
  (type $related (record (field "message" string) (field "path" string) (field "start" $position) (field "end" $position)))
  (type $optional-reference (option $source-reference))
  (type $relations (list $related))
  (type $fixes (list $fix))
  (type $diagnostic (record (field "reference" $optional-reference) (field "explanation" string) (field "help" string) (field "documentation-url" string) (field "related" $relations) (field "rule" string) (field "code" string) (field "severity" string) (field "message" string) (field "path" string) (field "start" $position) (field "end" $position) (field "fixes" $fixes)))
  (type $example (record (field "description" string) (field "before" string) (field "after" string)))
  (type $examples (list $example))
  (type $descriptor (record (field "description" string) (field "category" string) (field "subcategory" string) (field "maturity" string) (field "provider" string) (field "recommended" bool) (field "explanation" string) (field "help" string) (field "documentation-url" string) (field "fix-availability" string) (field "options-schema" string) (field "examples" $examples) (field "name" string) (field "requires" $facts)))
  (type $diagnostics (list $diagnostic))
  (type $optional-string (option string))
  (type $outcome (record (field "diagnostics" $diagnostics) (field "error" $optional-string)))
  (func $describe (result $descriptor)
    (canon lift (core func $i "describe") (memory (core memory $i "memory"))))
  (func $trap (result $descriptor)
    (canon lift (core func $i "trap") (memory (core memory $i "memory"))))
  (func $hang (result $descriptor)
    (canon lift (core func $i "hang") (memory (core memory $i "memory"))))
  (func $analyze (param "input" $input) (result $outcome)
    (canon lift (core func $i "analyze") (memory (core memory $i "memory")) (realloc (core func $i "realloc"))))
  (instance $analyzer
    (export "source-reference" (type $source-reference))
    (export "revision" (type $revision))
    (export "position" (type $position))
    (export "span" (type $span))
    (export "invocation" (type $invocation))
    (export "runtime" (type $runtime))
    (export "script" (type $script))
    (export "key-state" (type $key-state))
    (export "entry" (type $entry))
    (export "mapping" (type $mapping))
    (export "fact" (type $fact))
    (export "dependency" (type $dependency))
    (export "input" (type $input))
    (export "edit" (type $edit))
    (export "fix" (type $fix))
    (export "related" (type $related))
    (export "diagnostic" (type $diagnostic))
    (export "example" (type $example))
    (export "descriptor" (type $descriptor))
    (export "outcome" (type $outcome))
    (export "describe" (func $describe))
    (export "analyze" (func $analyze))
    (export "trap" (func $trap))
    (export "hang" (func $hang)))
  (export "kjanat:actionlint/analyzer@0.1.0" (instance $analyzer)))
