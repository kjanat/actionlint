(component
  (core module $destructor
    (func (export "drop") (param $rep i32)
      (if (i32.eqz (local.get $rep))
        (then unreachable)
        (else (loop $forever (br $forever))))))
  (core instance $d (instantiate $destructor))
  (type $resource (resource (rep i32) (dtor (core func $d "drop"))))
  (core func $new (canon resource.new $resource))
  (core instance $resource-api (export "new" (func $new)))
  (core module $m
    (import "resource" "new" (func $new (param i32) (result i32)))
    (memory (export "memory") 1)
    (data (i32.const 32) "close-fixture")
    (func $describe (export "describe") (result i32)
      (i32.store (i32.const 64) (i32.const 32))
      (i32.store (i32.const 68) (i32.const 13))
      (i32.store (i32.const 72) (i32.const 0))
      (i32.store (i32.const 76) (i32.const 0))
      (i32.const 64))
    (func (export "trap") (result i32)
      (drop (call $new (i32.const 0)))
      (call $describe))
    (func (export "hang") (result i32)
      (drop (call $new (i32.const 1)))
      (call $describe)))
  (core instance $i (instantiate $m (with "resource" (instance $resource-api))))
  (type $fact (enum "source" "scripts" "mappings" "invocations" "execution"))
  (type $facts (list $fact))
  (type $descriptor (record (field "name" string) (field "requires" $facts)))
  (func $describe (result $descriptor)
    (canon lift (core func $i "describe") (memory (core memory $i "memory"))))
  (func $trap (result $descriptor)
    (canon lift (core func $i "trap") (memory (core memory $i "memory"))))
  (func $hang (result $descriptor)
    (canon lift (core func $i "hang") (memory (core memory $i "memory"))))
  (instance $analyzer
    (export "fact" (type $fact))
    (export "descriptor" (type $descriptor))
    (export "describe" (func $describe))
    (export "trap" (func $trap))
    (export "hang" (func $hang)))
  (export "kjanat:actionlint/analyzer@0.1.0" (instance $analyzer)))
