{
  "schema_version": 1,
  "id": "github.com/kjanat/actionlint/examples/psscriptanalyzer",
  "version": "0.1.0",
  "role": "script",
  "scope": "source",
  "transport": "process",
  "rule": {
    "name": "psscriptanalyzer",
    "description": "Analyze PowerShell snippets with PSScriptAnalyzer",
    "category": "correctness",
    "subcategory": "powershell",
    "maturity": "stable",
    "provider": "psscriptanalyzer",
    "recommended": true,
    "fix_availability": "suggested"
  },
  "preparation": "kjanat:actionlint/expression-mask@0.1.0",
  "selectors": {
    "shells": [
      "pwsh",
      "powershell"
    ],
    "filename": "actionlint.ps1"
  },
  "capabilities": {
    "fixes": true,
    "reported_sources": false,
    "message_template": "{code}: {message}",
    "severities": {
      "error": "error",
      "warning": "warning",
      "info": "info"
    }
  },
  "config_schema": {
    "type": "object",
    "properties": {
      "IncludeRules": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "ExcludeRules": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "Severity": {
        "type": "array",
        "items": {
          "enum": [
            "Information",
            "Warning",
            "Error",
            "ParseError"
          ]
        },
        "uniqueItems": true
      },
      "IncludeDefaultRules": {
        "type": "boolean"
      },
      "Rules": {
        "type": "object",
        "additionalProperties": {
          "type": "object"
        }
      }
    },
    "additionalProperties": false
  },
  "process": {
    "entry": "pwsh",
    "args": [
      "-NoLogo",
      "-NoProfile",
      "-NonInteractive",
      "-Command",
      "$ErrorActionPreference = 'Stop'; [Console]::InputEncoding = [Text.UTF8Encoding]::new($false); [Console]::OutputEncoding = [Text.UTF8Encoding]::new($false); Import-Module PSScriptAnalyzer -MinimumVersion 1.25.0; $request = ConvertFrom-Json -AsHashtable -InputObject ([Console]::In.ReadToEnd()); ConvertTo-Json -Depth 6 -InputObject @(Invoke-ScriptAnalyzer -ScriptDefinition $request.source -Settings $request.config | Select-Object RuleName, Message, Severity, Extent, SuggestedCorrections)"
    ],
    "stdin": "request",
    "config": {
      "render": "json-stdin",
      "transform": {
        "language": "jq",
        "inline": "{config: (. // {}), vars: {}}"
      }
    },
    "env_passthrough": [
      "PATH",
      "PSModulePath",
      "SystemRoot",
      "TEMP",
      "TMP",
      "HOME",
      "USERPROFILE",
      "APPDATA",
      "LOCALAPPDATA"
    ],
    "version": {
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-Command",
        "$ErrorActionPreference = 'Stop'; Import-Module PSScriptAnalyzer -MinimumVersion 1.25.0; (Get-Module PSScriptAnalyzer).Version.ToString()"
      ],
      "pattern": "^([0-9]+\\.[0-9]+\\.[0-9]+)\\s*$",
      "minimum": "1.25.0"
    },
    "output": {
      "format": "json",
      "coordinates": {
        "rows": "source",
        "columns": "utf16",
        "end": "exclusive"
      },
      "transform": {
        "language": "jq",
        "digest": "sha256:17191df6bad66e7add96dfffcc6a78bfed8cc55fdfd926ffd464cb55ceda2194"
      }
    }
  }
}
