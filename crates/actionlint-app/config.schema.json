{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "description": "Analyzer configuration for actionlint.",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "JSON Schema location used by editors.",
      "type": [
        "null",
        "string"
      ]
    },
    "plugins": {
      "description": "Analyzer components. Relative paths resolve from this configuration file.",
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
