package kjanat:actionlint@0.2.0;

/// Invocation facts for the current analyze call. IDs are opaque host identities.
/// No graph is available during describe or configuration negotiation.
interface invocation-context {
    /// IDs are unique across entry, calls and scripts within a graph. Guests
    /// compare them verbatim; the host currently supplies 64 lowercase hex digits.
    type occurrence-id = string;
    record source-reference {
        document: string,
        revision: string,
        node: string,
        address: string,
    }

    /// One-based Unicode character position in a document.
    ///
    /// Range ends are exclusive and may lie on a later line.
    record position {
        line: u32,
        column: u32,
    }


    enum entry-kind { workflow, action }
    /// The entry identifies the analyzed source snapshot and has depth zero.
    record entry {
        id: occurrence-id,
        kind: entry-kind,
        reference: source-reference,
    }
    record budget { max-depth: u32, max-calls: u32, max-scripts: u32 }
    enum condition { enabled, skipped, runtime-dependent }
    enum script-kind { run, action-input }
    record script-occurrence {
        id: occurrence-id,
        owner: occurrence-id,
        /// Entry through owner, in traversal order; length equals depth + 1.
        /// Owner is the containing document invocation for both run scripts and
        /// action-input text. Action inputs do not execute the referenced action.
        ancestry: list<occurrence-id>,
        depth: u32,
        declaration: source-reference,
        kind: script-kind,
        input: string,
    }
    enum opaque-reason { dockerfile-only, non-composite }
    record opaque { reason: opaque-reason, detail: string }
    enum unavailable-reason { non-local, not-fetched, lookup-disabled, placement-uncertain }
    record unavailable { reason: unavailable-reason, detail: string }
    enum unresolved-reason { invalid-call, missing-manifest, read-failed, parse-failed, mapping-failed }
    record unresolved { reason: unresolved-reason, detail: string }
    enum interruption-reason { canceled, operational-failure }
    record interruption { reason: interruption-reason, detail: string }
    record interrupted { interruption: interruption, target: option<source-reference> }
    record cycle {
        target: source-reference,
        active: source-reference,
        owner: occurrence-id,
        closing: occurrence-id,
    }
    variant outcome {
        expanded(source-reference),
        opaque(opaque),
        unavailable(unavailable),
        unresolved(unresolved),
        dynamic(string),
        cycle(cycle),
        depth-limited(u32),
        interrupted(interrupted),
    }
    record call {
        id: occurrence-id,
        parent: occurrence-id,
        /// Entry through parent, excluding this call; length equals depth.
        ancestry: list<occurrence-id>,
        depth: u32,
        site: source-reference,
        /// None means no source coordinate is available.
        step: option<position>,
        uses: option<string>,
        condition: condition,
        outcome: outcome,
    }
    enum stop-limit { total, scripts }
    /// First rejected declaration: a call site for total, script source for
    /// scripts. It has no record or ID. Max equals the corresponding budget.
    /// Script limits include the entry document; consumers must report partial
    /// analysis when expansion or script collection stopped.
    record stop { parent: occurrence-id, site: source-reference, limit: stop-limit, max: u32 }
    record summary {
        entry: entry,
        budget: budget,
        calls: u32,
        scripts: u32,
        stop: option<stop>,
        entry-interruption: option<interruption>,
        /// True only when every call is expanded or opaque, without a stop or
        /// entry interruption. Other outcomes describe incomplete work.
        /// Conditions describe each call's expression; skipped/runtime-dependent
        /// ancestors remain visible and do not prune descendants from this graph.
        complete: bool,
    }
    /// All queries return an error when invocation facts are unavailable.
    /// Counts cover stored records only, including incomplete call outcomes.
    describe: func() -> result<summary, string>;
    /// Records remain stable in registration order; parents precede children.
    /// Offset may equal the count, returning an empty page.
    /// Limit must be 1..256; invalid bounds return an error, never partial success.
    calls: func(offset: u32, limit: u32) -> result<list<call>, string>;
    scripts: func(offset: u32, limit: u32) -> result<list<script-occurrence>, string>;
    /// Unknown IDs, including malformed strings or IDs of another record kind, return none.
    call-by-id: func(id: occurrence-id) -> result<option<call>, string>;
    script-by-id: func(id: occurrence-id) -> result<option<script-occurrence>, string>;
}

/// A plugin analyzes one document at a time.
///
/// The host hands over the document and the facts the plugin declared in its
/// descriptor, and takes back diagnostics.
interface analyzer {
    use invocation-context.{source-reference, position, occurrence-id};

    record revision {
        path: string,
        digest: string,
    }

    /// Maps the text columns [start, end) of one line of script text to the declaring document.
    /// `document` is the position of the first mapped character.
    /// `document-end` is set for a decoded escape sequence whose source width differs from its text width.
    ///
    /// To place a finding at text (line, column): find the span with that line where `start <= column < end`;
    /// the document position is `document.column + column - start` on `document.line`.
    /// For an exclusive end column use `start < column <= end` and take `document-end` when it is set
    /// and `column == end`. A zero-width span (`start == end`) matches an exclusive column equal to `start`.
    record span {
        line: u32,
        start: u32,
        end: u32,
        document: position,
        document-end: option<position>,
    }

    /// Shell and working directory the runner would use.
    ///
    /// The `known` flags report whether static analysis determined the value.
    /// `shell-implicit` marks a shell supplied by the runner or platform rather than by declaration.
    record runtime {
        shell: string,
        shell-known: bool,
        shell-implicit: bool,
        directory: string,
        directory-known: bool,
    }

    /// A declared run script.
    ///
    /// `shell` is the declared shell without runner defaults.
    /// `start` points to the run value in the document at `path`;
    /// an empty `path` means the analyzed document.
    /// `occurrence` identifies this execution when invocation facts are available.
    /// `runtime` is set when the `execution` fact was requested.
    record script {
        reference: source-reference,
        job-id: string,
        step-id: string,
        text: string,
        shell: string,
        start: position,
        path: string,
        spans: list<span>,
        occurrence: option<occurrence-id>,
        runtime: option<runtime>,
    }

    record action-input {
        script: script,
        language: string,
        action: string,
        input: string,
    }

    /// Distinguishes a runtime name from a statically invalid declaration.
    enum key-state {
        unknown,
        known,
        invalid,
    }

    /// One normalized mapping key.
    ///
    /// `evaluated` entries came from object expressions and must not be interpreted again.
    record entry {
        name: string,
        state: key-state,
        source: string,
        evaluated: bool,
        start: position,
    }

    /// Normalized names and source provenance for a declaration.
    ///
    /// `complete` is false when an insertion or key depends on runtime values.
    record mapping {
        reference: source-reference,
        scope: string,
        complete: bool,
        entries: list<entry>,
    }

    /// Shared information a plugin can request.
    enum fact {
        source,
        scripts,
        mappings,
        invocations,
        execution,
        dependencies,
    }

    record dependency {
        reference: source-reference,
        uses: string,
        kind: string,
        start: position,
        end: position,
    }

    /// One document and its facts. `options` holds the JSON the host registered for this plugin,
    /// or an empty string.
    ///
    /// `scripts` are declared by the document itself.
    /// `invoked` scripts belong to composite actions the document calls and name their own `path`.
    record input {
        reference: source-reference,
        path: string,
        content: string,
        kind: string,
        parse-status: string,
        available: list<fact>,
        options: string,
        scripts: list<script>,
        invoked: list<script>,
        mappings: list<mapping>,
        dependencies: list<dependency>,
        /// None selects all graph scripts; some(empty) selects no script text.
        selected-scripts: option<list<occurrence-id>>,
        action-inputs: list<action-input>,
    }

    /// Replaces a half-open Unicode range in the original source file.
    record edit {
        path: string,
        start: position,
        end: position,
        replacement: string,
    }

    /// One complete suggested change. All edits apply together.
    record fix {
        applicability: string,
        revisions: list<revision>,
        description: string,
        edits: list<edit>,
    }

    record related {
        message: string,
        path: string,
        start: position,
        end: position,
    }

    /// A finding. `rule` must be empty or equal the descriptor name; `code`
    /// carries a plugin-specific check identifier. An empty `rule` or `path`
    /// takes the plugin name or analyzed document. `severity` carries its level.
    record diagnostic {
        reference: option<source-reference>,
        explanation: string,
        help: string,
        documentation-url: string,
        related: list<related>,
        rule: string,
        code: string,
        severity: string,
        message: string,
        path: string,
        start: position,
        end: position,
        fixes: list<fix>,
    }

    record example {
        description: string,
        before: string,
        after: string,
    }

    /// Plugin identity and the facts it needs before any document is analyzed.
    record descriptor {
        description: string,
        category: string,
        subcategory: string,
        maturity: string,
        provider: string,
        recommended: bool,
        explanation: string,
        help: string,
        documentation-url: string,
        fix-availability: string,
        options-schema: string,
        examples: list<example>,
        name: string,
        requires: list<fact>,
    }

    describe: func() -> descriptor;

    record outcome {
        diagnostics: list<diagnostic>,
        error: option<string>,
    }

    /// Returns findings and an optional explanation of incomplete analysis.
    ///
    /// A trap, an exit or an exceeded limit is reported by the host as a failed analysis.
    analyze: func(input: input) -> outcome;
}

/// Capabilities granted to every plugin.
interface host {
    /// Writes one diagnostic line to the host's log.
    log: func(message: string);
}

world plugin {
    import host;
    import invocation-context;
    export analyzer;
}
