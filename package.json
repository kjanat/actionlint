{
  "name": "actionlint",
  "version": "",
  "private": true,
  "description": "Static checker for GitHub Actions workflow files",
  "homepage": "https://actionlint.kjanat.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kjanat/actionlint.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/kjanat"
  },
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "distribution/npm/facade",
    "packages/*",
    "playground"
  ],
  "scripts": {
    "comment-cop": "node .github/actions/comment-cop/comment-cop.mjs",
    "matcher:generate": "node ./scripts/generate-actionlint-matcher/main.mjs .github/actionlint-matcher.json",
    "test:comment-cop": "node --test ./.github/actions/comment-cop/comment-cop.test.mjs",
    "test:feed": "run -s @kjlint/changelog-rss:typecheck @kjlint/changelog-rss:test",
    "test:js": "run -p test:comment-cop test:feed test:matcher test:npm-facade test:shellcheck-versions typecheck",
    "test:matcher": "node --test ./scripts/generate-actionlint-matcher/test.mjs",
    "test:npm-facade": "node --test ./distribution/npm/facade/test/*.test.mjs",
    "test:shellcheck-versions": "node --test ./.github/actions/shellcheck-versions/shellcheck-version-lifecycle.test.mjs",
    "test:workspaces": "run -p @kjlint/changelog-rss:test playground:test",
    "typecheck": "run -q @typescript/native --noEmit"
  },
  "overrides": {
    "@actions/github-script": {
      "undici": ">=6.28.0"
    }
  },
  "devDependencies": {
    "@actions/github-script": "github:actions/github-script",
    "@types/node": "^26.4.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "feather-icons": "4.29.2",
    "runner-run": "^0.26.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "packageManager": "npm@12.0.2",
  "devEngines": {
    "packageManager": [
      {
        "name": "npm",
        "version": "12.0.2",
        "onFail": "warn"
      }
    ]
  },
  "volta": {
    "node": "26.8.2",
    "npm": "12.0.2"
  },
  "allowScripts": {
    "core-js": false
  }
}
