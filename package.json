{
  "name": "actionlint",
  "private": true,
  "description": "Static checker for GitHub Actions workflow files",
  "homepage": "https://actionlint.kjanat.dev",
  "repository": "https://github.com/kjanat/actionlint",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "playground"
  ],
  "scripts": {
    "build": "npm run build --workspace playground",
    "dev": "npm run dev --workspace playground",
    "lint": "npm run lint --workspace playground",
    "matcher:generate": "node ./scripts/generate-actionlint-matcher/main.mjs .github/actionlint-matcher.json",
    "preview": "npm run preview --workspace playground",
    "test": "run -p test:changelog-monitor test:feed test:matcher test:shellcheck-versions typecheck",
    "test:changelog-monitor": "node --test ./.github/actions/changelog-monitor/monitor.test.mjs",
    "test:feed": "node --test ./playground/test/feed.test.mjs",
    "test:matcher": "node --test ./scripts/generate-actionlint-matcher/test.mjs",
    "test:shellcheck-versions": "node --test ./.github/actions/shellcheck-versions/shellcheck-version-lifecycle.test.mjs",
    "test:workspaces": "npm run test --workspaces",
    "typecheck": "run -q @typescript/native --noEmit"
  },
  "overrides": {
    "undici": ">=6.28.0"
  },
  "dependencies": {
    "feather-icons": "4.28.0"
  },
  "devDependencies": {
    "@actions/github-script": "github:actions/github-script",
    "@types/node": "^26.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "runner-run": "^0.25.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "packageManager": "npm@11.19.0",
  "devEngines": {
    "packageManager": [
      {
        "name": "npm",
        "version": "11.19.0",
        "onFail": "download"
      }
    ]
  },
  "volta": {
    "node": "26.7.0",
    "npm": "11.19.0"
  }
}
