{
  "name": "actionlint",
  "version": "0.0.0",
  "private": true,
  "description": "Static checker for GitHub Actions workflow files",
  "homepage": "https://actionlint.kjanat.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kjanat/actionlint.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/kjanat"
  },
  "license": "MIT",
  "type": "module",
  "imports": {
    "#release/*": "./tools/release/*",
    "#schemas/*": "./schemas/*"
  },
  "workspaces": [
    "distribution/npm/facade",
    "distribution/pypi",
    "distribution/winget",
    "examples/plugins/external-linters",
    "examples/plugins/external-linters/*",
    "examples/plugins/psscriptanalyzer",
    "examples/plugins/typescript",
    "packages/*",
    "playground"
  ],
  "scripts": {
    "lint:biome": "biome check . --error-on-warnings",
    "lint:workspaces": "bun run --filter '*' --if-present lint",
    "test:js": "run -p //.github/ci:test //.github/actions/comment-cop:test //.github/actions/setup-pandoc:test //.github/actions/setup-runner:test //.github/actions/setup-shellcheck:test //.github/actions/setup-wasm-toolchain:test //tools/matcher:test //tools/release:test //tools/toolchain:test //distribution/docker:test //tools/action:test typecheck @kjanat/actionlint-winget:typecheck @kjanat/actionlint-winget:test @kjanat/actionlint:test @kjanat/actionlint-pypi:test @kjlint/changelog-rss:typecheck @kjlint/changelog-rss:test",
    "test:workspaces": "bun run --filter '*' --if-present test",
    "typecheck": "run -s @kjanat-actionlint/plugin-sdk:build typecheck:root typecheck:workspaces",
    "typecheck:root": "run -q @typescript/native --noEmit",
    "typecheck:workspaces": "bun run --workspaces --sequential --shell=bun --if-present typecheck"
  },
  "overrides": {
    "undici": ">=8.11.2"
  },
  "dependencies": {
    "feather-icons": "4.28.0"
  },
  "devDependencies": {
    "@actions/github-script": "github:actions/github-script",
    "@octokit/openapi-webhooks-types": "latest",
    "@types/node": "^26",
    "@typescript/native": "npm:typescript@^7",
    "biome": "npm:@biomejs/biome@^2.5",
    "pkg-pr-new": "0.0.93",
    "runner-run": "^0.28",
    "tsc-rs": "^0.7",
    "typescript": "npm:@typescript/typescript6@^6",
    "vscode-languageserver-textdocument": "^1",
    "yaml-language-server": "^2"
  },
  "devEngines": {
    "packageManager": [
      {
        "name": "bun",
        "onFail": "warn"
      }
    ],
    "runtime": [
      {
        "name": "node",
        "version": ">=26",
        "onFail": "ignore"
      }
    ]
  },
  "allowScripts": {
    "core-js": false,
    "tsc-rs@0.7.0": true
  },
  "catalog": {
    "@kjanat/dreamcli": "^5.0.0"
  }
}
