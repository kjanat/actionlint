{
  "name": "actionlint",
  "version": "0.0.0",
  "private": true,
  "description": "Static checker for GitHub Actions workflow files",
  "homepage": "https://actionlint.kjanat.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kjanat/actionlint.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/kjanat"
  },
  "license": "MIT",
  "type": "module",
  "imports": {
    "#internal/*": "./internal/*",
    "#release/*": "./internal/release/*",
    "#schemas/*": "./schemas/*"
  },
  "workspaces": [
    "distribution/npm/facade",
    "distribution/pypi",
    "distribution/winget",
    "packages/*",
    "playground"
  ],
  "scripts": {
    "lint:biome": "biome check . --error-on-warnings",
    "lint:workspaces": "npm run lint --workspaces --if-present",
    "test:js": "run -p //.github/ci:test //.github/actions/comment-cop:test //internal/githubaction/matcher:test //.github/actions/shellcheck-versions:test //internal/release:test //internal/toolchain:test //internal/githubaction/container:test //internal/githubaction/tooling:test typecheck @kjanat/actionlint-winget:typecheck @kjanat/actionlint-winget:test @kjanat/actionlint:test @kjanat/actionlint-pypi:test @kjlint/changelog-rss:typecheck @kjlint/changelog-rss:test",
    "test:workspaces": "npm run test --workspaces --if-present",
    "typecheck": "run -q @typescript/native --noEmit"
  },
  "overrides": {
    "@actions/github-script": {
      "undici": ">=8.11.2"
    }
  },
  "dependencies": {
    "feather-icons": "4.28.0"
  },
  "devDependencies": {
    "@actions/github-script": "github:actions/github-script",
    "@octokit/webhooks-types": "^7",
    "@types/node": "^26",
    "@typescript/native": "npm:typescript@^7",
    "biome": "npm:@biomejs/biome@^2.5",
    "runner-run": "^0.28",
    "tsc-rs": "^0.7",
    "typescript": "npm:@typescript/typescript6@^6",
    "vscode-languageserver-textdocument": "^1",
    "yaml-language-server": "^2"
  },
  "devEngines": {
    "packageManager": [
      {
        "name": "npm",
        "version": ">=12",
        "onFail": "warn"
      }
    ],
    "runtime": [
      {
        "name": "node",
        "version": ">=26",
        "onFail": "ignore"
      }
    ]
  },
  "allowScripts": {
    "core-js": false,
    "tsc-rs@0.7.0": true
  }
}
