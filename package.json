{
  "name": "actionlint",
  "version": "0.0.0",
  "private": true,
  "description": "Static checker for GitHub Actions workflow files",
  "homepage": "https://actionlint.kjanat.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kjanat/actionlint.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/kjanat"
  },
  "license": "MIT",
  "type": "module",
  "imports": {
    "#release/*": "./tools/release/*",
    "#schemas/*": "./schemas/*"
  },
  "workspaces": [
    "distribution/npm",
    "distribution/npm/facade",
    "distribution/pypi",
    "distribution/winget",
    "plugins/examples/external-linters",
    "plugins/examples/external-linters/*",
    "plugins/examples/psscriptanalyzer",
    "plugins/examples/typescript",
    "libraries/*",
    "applications/github-action",
    "plugins/sdk/typescript",
    "applications/playground"
  ],
  "overrides": {
    "undici": ">=8.11.2"
  },
  "dependencies": {
    "feather-icons": "4.28.0"
  },
  "devDependencies": {
    "@actions/github-script": "github:actions/github-script",
    "@octokit/openapi-webhooks-types": "latest",
    "@types/bun": "^1.4.4",
    "@types/node": "^26",
    "@typescript/native": "npm:typescript@^7",
    "biome": "npm:@biomejs/biome@^2.5",
    "pkg-pr-new": "0.0.93",
    "runner-run": "^0.28",
    "tsc-rs": "^0.8",
    "typescript": "npm:@typescript/typescript6@^6",
    "vscode-languageserver-textdocument": "^1",
    "yaml-language-server": "^2"
  },
  "devEngines": {
    "packageManager": [
      {
        "name": "bun",
        "onFail": "warn"
      }
    ],
    "runtime": [
      {
        "name": "node",
        "version": ">=26",
        "onFail": "ignore"
      }
    ]
  },
  "allowScripts": {
    "@actions/github-script": false,
    "core-js": false,
    "tsc-rs@0.8.0": true
  },
  "catalog": {
    "@kjanat/dreamcli": "^5.0.0"
  }
}
