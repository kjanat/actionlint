{
  "name": "actionlint",
  "private": true,
  "description": "Static checker for GitHub Actions workflow files",
  "homepage": "https://actionlint.kjanat.dev",
  "repository": "https://github.com/kjanat/actionlint",
  "funding": { "type": "github", "url": "https://github.com/sponsors/kjanat" },
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "distribution/npm/facade",
    "packages/*",
    "playground"
  ],
  "scripts": {
    "build": "npm run build --workspace playground",
    "comment-cop": "node .github/actions/comment-cop/comment-cop.mjs",
    "dev": "npm run dev --workspace playground",
    "lint": "npm run lint:biome && npm run lint --workspace playground",
    "lint:biome": "biome check . --error-on-warnings",
    "matcher:generate": "node ./scripts/generate-actionlint-matcher/main.mjs .github/actionlint-matcher.json",
    "preview": "npm run preview --workspace playground",
    "test": "run test:js",
    "test:comment-cop": "node --test ./.github/actions/comment-cop/comment-cop.test.mjs",
    "test:feed": "run -s @kjlint/changelog-rss:typecheck @kjlint/changelog-rss:test",
    "test:js": "run -p test:comment-cop test:feed test:matcher test:npm-facade test:shellcheck-versions typecheck",
    "test:matcher": "node --test ./scripts/generate-actionlint-matcher/test.mjs",
    "test:npm-facade": "node --test ./distribution/npm/facade/test/*.test.mjs",
    "test:shellcheck-versions": "node --test ./.github/actions/shellcheck-versions/shellcheck-version-lifecycle.test.mjs",
    "test:workspaces": "npm run test --workspaces",
    "typecheck": "run -q @typescript/native --noEmit",
    "update:pyflakes": "npm run update:pyflakes --workspace actionlint-action",
    "update:shellcheck": "npm run update:shellcheck --workspace actionlint-action"
  },
  "overrides": { "@actions/github-script": { "undici": ">=6.28.0" } },
  "dependencies": { "feather-icons": "4.29.2" },
  "devDependencies": {
    "@actions/github-script": "github:actions/github-script",
    "@types/node": "^26.4.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "biome": "npm:@biomejs/biome@^2.5.14",
    "runner-run": "^0.26.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "packageManager": "npm@12.0.2",
  "devEngines": {
    "packageManager": [
      {
        "name": "npm",
        "version": "12.0.2",
        "onFail": "warn"
      }
    ]
  },
  "volta": {
    "node": "26.9.0",
    "npm": "12.0.2"
  },
  "allowScripts": {
    "core-js": false
  }
}
