{
  "name": "actionlint-action",
  "private": true,
  "description": "JavaScript launcher for the actionlint GitHub Action",
  "type": "module",
  "imports": {
    "#*": "./src/*.ts",
    "#pkg": "./package.json",
    "#tools/*": "./tools/*.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "update:pyflakes": "curl -fsSL https://pypi.org/pypi/pyflakes/json | jq \"del(.releases)\" > tools/pyflakes.json",
    "update:shellcheck": "gh release view --repo koalaman/shellcheck --json apiUrl,assets,author,body,createdAt,databaseId,id,isDraft,isImmutable,isPrerelease,name,publishedAt,tagName,tarballUrl,targetCommitish,uploadUrl,url,zipballUrl --jq . > tools/shellcheck.json"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsdown": "0.23.0"
  },
  "engines": { "node": "24" },
  "volta": { "node": "24.21.0" }
}
