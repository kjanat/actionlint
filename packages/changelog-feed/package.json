{
  "name": "@kjlint/changelog-rss",
  "version": "0.0.3",
  "description": "RSS parser, browser reader, and issue monitor for the GitHub Actions changelog feed",
  "homepage": "https://actionlint.kjanat.dev/github-changelog",
  "repository": "kjanat/actionlint",
  "funding": { "type": "github", "url": "https://github.com/sponsors/kjanat" },
  "license": "MIT",
  "sideEffects": ["./dist/index.js", "./dist/github-actions-reader.js"],
  "type": "module",
  "imports": {
    "#action": {
      "source": "./src/github-actions-monitor.ts",
      "types": "./dist/github-actions-monitor.d.ts",
      "default": "./dist/github-actions-monitor.js"
    },
    "#feed": {
      "source": "./src/github-actions-feed.ts",
      "types": "./dist/github-actions-feed.d.ts",
      "default": "./dist/github-actions-feed.js"
    },
    "#reader": {
      "source": "./src/github-actions-reader.ts",
      "types": "./dist/github-actions-reader.d.ts",
      "default": "./dist/github-actions-reader.js"
    },
    "#rss": { "source": "./src/index.ts", "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "#pkg": "./package.json"
  },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./feed": { "types": "./dist/github-actions-feed.d.ts", "default": "./dist/github-actions-feed.js" },
    "./reader": { "types": "./dist/github-actions-reader.d.ts", "default": "./dist/github-actions-reader.js" },
    "./action": { "types": "./dist/github-actions-monitor.d.ts", "default": "./dist/github-actions-monitor.js" },
    "./package.json": "./package.json"
  },
  "files": ["/dist", "/src"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node --conditions=source --test ./tests/*.test.ts",
    "typecheck": "tsc"
  },
  "devDependencies": { "@actions/github-script": "github:actions/github-script", "typescript": ">=7" },
  "volta": { "extends": "../../package.json" }
}
