# Maintainer: Kaj Kowalski <info@kajkowalski.nl>

# Prebuilt package: installs the release binary straight from the GitHub
# release `.tar.gz` assets (no compile). `pkgver`/`sha256sums_*` are rewritten
# by CI (.github/workflows/aur-release.yml) on every release; the values below
# are only a checked-in reference snapshot.
pkgname=actionlint-kjanat-bin
pkgver=1.13.0
pkgrel=1
pkgdesc='Static checker for GitHub Actions workflow files (kjanat fork, prebuilt binary)'
arch=('x86_64' 'aarch64' 'armv7h')
url='https://github.com/kjanat/actionlint'
license=('MIT')
# Release binaries are built with CGO_ENABLED=0, so they are statically linked
# and pull in nothing at runtime.
depends=()
optdepends=(
	'shellcheck: check shell scripts in `run:` steps'
	'python-pyflakes: check Python scripts in `run:` steps'
)
provides=('actionlint' "actionlint-kjanat=$pkgver")
conflicts=('actionlint' 'actionlint-kjanat' 'actionlint-kjanat-git')

# Per-arch release tarballs. GoReleaser puts the GOOS/GOARCH pair in the
# basename, so each arch downloads to a distinct file, no `name::` rename
# needed (and none with a literal arch that namcap would flag). armv7h uses
# the armv6 build, which runs on armv7 hardware.
_url="https://github.com/kjanat/actionlint/releases/download/v$pkgver/actionlint_${pkgver}"
source_x86_64=("${_url}_linux_amd64.tar.gz")
source_aarch64=("${_url}_linux_arm64.tar.gz")
source_armv7h=("${_url}_linux_armv6.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')
sha256sums_armv7h=('SKIP')

package() {
	# Archives are flat: actionlint, README.md, LICENSE.txt at the root, plus
	# docs/ and man/ subdirectories.
	install -Dm0755 actionlint "$pkgdir/usr/bin/actionlint"
	install -Dm0644 LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE.txt"
	install -Dm0644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
	install -Dm0644 -t "$pkgdir/usr/share/doc/$pkgname/" docs/*.md

	# Man page ships in the archive already rendered. makepkg gzips it (zipman).
	install -Dm0644 man/actionlint.1 "$pkgdir/usr/share/man/man1/actionlint.1"

	# Shell completions. `-completion <shell>` writes a script for one shell to
	# stdout; the binary is native to $CARCH here, so it can just be run.
	install -dm0755 "$pkgdir/usr/share/bash-completion/completions" \
		"$pkgdir/usr/share/zsh/site-functions" \
		"$pkgdir/usr/share/fish/vendor_completions.d" \
		"$pkgdir/usr/share/actionlint"
	./actionlint -completion bash >"$pkgdir/usr/share/bash-completion/completions/actionlint"
	./actionlint -completion zsh >"$pkgdir/usr/share/zsh/site-functions/_actionlint"
	./actionlint -completion fish >"$pkgdir/usr/share/fish/vendor_completions.d/actionlint.fish"
	# PowerShell has no system autoload dir on Linux; pwsh users dot-source
	# this file from their `$PROFILE`:  . /usr/share/actionlint/actionlint.ps1
	./actionlint -completion powershell >"$pkgdir/usr/share/actionlint/actionlint.ps1"
	chmod 0644 "$pkgdir/usr/share/bash-completion/completions/actionlint" \
		"$pkgdir/usr/share/zsh/site-functions/_actionlint" \
		"$pkgdir/usr/share/fish/vendor_completions.d/actionlint.fish" \
		"$pkgdir/usr/share/actionlint/actionlint.ps1"
}
