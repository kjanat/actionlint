{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "action": {
      "type": "object",
      "required": [
        "inputs",
        "kind",
        "outputs",
        "parse_status",
        "path",
        "runs"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/actionInput"
          }
        },
        "jobs": false,
        "kind": {
          "const": "action"
        },
        "name": {
          "type": "string"
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/actionOutput"
          }
        },
        "parse_status": {
          "enum": [
            "complete",
            "partial",
            "failed"
          ]
        },
        "path": {
          "type": "string"
        },
        "runs": {
          "$ref": "#/definitions/actionRuns"
        },
        "triggers": false
      }
    },
    "actionInput": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "default": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "start": {
          "$ref": "#/definitions/position"
        }
      }
    },
    "actionOutput": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "start": {
          "$ref": "#/definitions/position"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "actionRuns": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "steps"
          ],
          "properties": {
            "args": false,
            "entrypoint": false,
            "image": false,
            "kind": {
              "const": "composite"
            },
            "main": false,
            "plugin": false,
            "post": false,
            "post_entrypoint": false,
            "post_if": false,
            "pre": false,
            "pre_entrypoint": false,
            "pre_if": false,
            "steps": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/step"
              }
            },
            "using": false
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "using"
          ],
          "properties": {
            "args": false,
            "entrypoint": false,
            "image": false,
            "kind": {
              "const": "javascript"
            },
            "main": {
              "type": "string"
            },
            "plugin": false,
            "post": {
              "type": "string"
            },
            "post_entrypoint": false,
            "post_if": {
              "type": "string"
            },
            "pre": {
              "type": "string"
            },
            "pre_entrypoint": false,
            "pre_if": {
              "type": "string"
            },
            "steps": false,
            "using": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "args",
            "kind"
          ],
          "properties": {
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "entrypoint": {
              "type": "string"
            },
            "image": {
              "type": "string"
            },
            "kind": {
              "const": "docker"
            },
            "main": false,
            "plugin": false,
            "post": false,
            "post_entrypoint": {
              "type": "string"
            },
            "post_if": false,
            "pre": false,
            "pre_entrypoint": {
              "type": "string"
            },
            "pre_if": false,
            "steps": false,
            "using": false
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "plugin"
          ],
          "properties": {
            "args": false,
            "entrypoint": false,
            "image": false,
            "kind": {
              "const": "plugin"
            },
            "main": false,
            "plugin": {
              "type": "string"
            },
            "post": false,
            "post_entrypoint": false,
            "post_if": false,
            "pre": false,
            "pre_entrypoint": false,
            "pre_if": false,
            "steps": false,
            "using": false
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "args": false,
            "entrypoint": false,
            "image": false,
            "kind": {
              "const": "unknown"
            },
            "main": false,
            "plugin": false,
            "post": false,
            "post_entrypoint": false,
            "post_if": false,
            "pre": false,
            "pre_entrypoint": false,
            "pre_if": false,
            "steps": false,
            "using": {
              "type": "string"
            }
          }
        }
      ]
    },
    "configuration": {
      "type": "object",
      "required": [
        "file",
        "overrides",
        "project"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "origins": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/origin"
          }
        },
        "overrides": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "project": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/warning"
          }
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "end",
        "message",
        "path",
        "rule",
        "start"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "end": {
          "$ref": "#/definitions/position"
        },
        "fixes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/fix"
          }
        },
        "message": {
          "type": "string"
        },
        "path": {
          "description": "Analyzed source path; relative paths use the Action working directory.",
          "type": "string"
        },
        "rule": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "snippet": {
          "type": "string"
        },
        "start": {
          "$ref": "#/definitions/position"
        }
      }
    },
    "document": {
      "oneOf": [
        {
          "$ref": "#/definitions/workflow"
        },
        {
          "$ref": "#/definitions/action"
        }
      ]
    },
    "edit": {
      "type": "object",
      "required": [
        "end",
        "path",
        "replacement",
        "start"
      ],
      "properties": {
        "end": {
          "$ref": "#/definitions/position"
        },
        "path": {
          "type": "string"
        },
        "replacement": {
          "type": "string"
        },
        "start": {
          "$ref": "#/definitions/position"
        }
      }
    },
    "fix": {
      "type": "object",
      "required": [
        "description",
        "edits"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "edits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/edit"
          }
        }
      }
    },
    "job": {
      "type": "object",
      "required": [
        "id",
        "needs",
        "steps"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "needs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reference": {
          "$ref": "#/definitions/reference"
        },
        "start": {
          "$ref": "#/definitions/position"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/step"
          }
        },
        "uses": {
          "type": "string"
        }
      }
    },
    "origin": {
      "type": "object",
      "required": [
        "source",
        "state"
      ],
      "properties": {
        "column": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "input": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "source": {
          "type": "string"
        },
        "state": {
          "type": "string"
        }
      }
    },
    "position": {
      "description": "One-based line and Unicode character column. End positions are exclusive.",
      "type": "object",
      "required": [
        "column",
        "line"
      ],
      "properties": {
        "column": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "reference": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "host_source",
            "kind",
            "owner",
            "ref",
            "repo",
            "subpath"
          ],
          "properties": {
            "host": {
              "type": "string"
            },
            "host_source": {
              "enum": [
                "default",
                "explicit",
                "self"
              ]
            },
            "image": false,
            "kind": {
              "const": "repository"
            },
            "name": false,
            "owner": {
              "type": "string"
            },
            "path": false,
            "ref": {
              "type": "string"
            },
            "repo": {
              "type": "string"
            },
            "scheme": {
              "type": "string"
            },
            "subpath": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "path"
          ],
          "properties": {
            "host": false,
            "host_source": false,
            "image": false,
            "kind": {
              "const": "workspace"
            },
            "name": false,
            "owner": false,
            "path": {
              "type": "string"
            },
            "ref": false,
            "repo": false,
            "scheme": false,
            "subpath": false
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "path"
          ],
          "properties": {
            "host": false,
            "host_source": false,
            "image": false,
            "kind": {
              "const": "self-repository"
            },
            "name": false,
            "owner": false,
            "path": {
              "type": "string"
            },
            "ref": false,
            "repo": false,
            "scheme": false,
            "subpath": false
          }
        },
        {
          "type": "object",
          "required": [
            "image",
            "kind"
          ],
          "properties": {
            "host": false,
            "host_source": false,
            "image": {
              "type": "string"
            },
            "kind": {
              "const": "container"
            },
            "name": false,
            "owner": false,
            "path": false,
            "ref": false,
            "repo": false,
            "scheme": false,
            "subpath": false
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "host": false,
            "host_source": false,
            "image": false,
            "kind": {
              "const": "builtin"
            },
            "name": {
              "type": "string"
            },
            "owner": false,
            "path": false,
            "ref": false,
            "repo": false,
            "scheme": false,
            "subpath": false
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "host": false,
            "host_source": false,
            "image": false,
            "kind": {
              "const": "unknown"
            },
            "name": false,
            "owner": false,
            "path": false,
            "ref": false,
            "repo": false,
            "scheme": false,
            "subpath": false
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "description": "Known kinds: run, uses, wait, cancel, parallel, unknown. New kinds may be added.",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "reference": {
          "$ref": "#/definitions/reference"
        },
        "start": {
          "$ref": "#/definitions/position"
        },
        "steps": {
          "description": "Children of a parallel step, in declaration order.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/step"
          }
        },
        "uses": {
          "type": "string"
        }
      }
    },
    "warning": {
      "type": "object",
      "required": [
        "column",
        "line",
        "message"
      ],
      "properties": {
        "column": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "line": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "message": {
          "type": "string"
        }
      }
    },
    "workflow": {
      "description": "Parsed workflow declarations. Parse status is independent of analysis completion.",
      "type": "object",
      "required": [
        "jobs",
        "kind",
        "parse_status",
        "path",
        "triggers"
      ],
      "properties": {
        "description": false,
        "inputs": false,
        "jobs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/job"
          }
        },
        "kind": {
          "const": "workflow"
        },
        "name": {
          "type": "string"
        },
        "outputs": false,
        "parse_status": {
          "enum": [
            "complete",
            "partial",
            "failed"
          ]
        },
        "path": {
          "type": "string"
        },
        "runs": false,
        "triggers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "title": "actionlint analysis result v1",
  "description": "Shared version 1 result for CLI JSON, Action JSON, and the Action result-file. Analysis status is independent of fail-on-error and optional reporting. Unknown properties are allowed for compatible additions. Diagnostic and edit end positions must not precede their starts; the runtime enforces this additional invariant.",
  "type": "object",
  "required": [
    "completed",
    "configurations",
    "diagnostics",
    "exit_code",
    "file_count",
    "hints",
    "schema_version",
    "status"
  ],
  "properties": {
    "completed": {
      "type": "boolean"
    },
    "configurations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/configuration"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/diagnostic"
      }
    },
    "documents": {
      "description": "Available workflow and action document outlines. Older producers may omit this field.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/document"
      }
    },
    "error": {
      "type": "string"
    },
    "exit_code": {
      "enum": [
        0,
        1,
        2,
        3
      ]
    },
    "file_count": {
      "description": "Number of selected workflow files, or null when unknown. Zero means no workflows selected.",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "hints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sarif": {
      "description": "Optional SARIF report. Availability depends on the producer.",
      "type": "object",
      "required": [
        "runs",
        "version"
      ],
      "properties": {
        "runs": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "version": {
          "const": "2.1.0"
        }
      }
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "success",
        "problems-found",
        "invalid-options",
        "failure"
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "completed": {
          "const": true
        },
        "diagnostics": {
          "maxItems": 0
        },
        "exit_code": {
          "const": 0
        },
        "status": {
          "const": "success"
        }
      }
    },
    {
      "properties": {
        "completed": {
          "const": true
        },
        "diagnostics": {
          "minItems": 1
        },
        "exit_code": {
          "const": 1
        },
        "status": {
          "const": "problems-found"
        }
      }
    },
    {
      "properties": {
        "completed": {
          "const": false
        },
        "exit_code": {
          "const": 2
        },
        "status": {
          "const": "invalid-options"
        }
      }
    },
    {
      "properties": {
        "completed": {
          "const": false
        },
        "exit_code": {
          "const": 3
        },
        "status": {
          "const": "failure"
        }
      }
    }
  ]
}
