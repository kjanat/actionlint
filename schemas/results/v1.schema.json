{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "configuration": {
      "type": "object",
      "required": [
        "file",
        "overrides",
        "project"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "origins": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/origin"
          }
        },
        "overrides": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "project": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/warning"
          }
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "end",
        "message",
        "path",
        "rule",
        "start"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "end": {
          "$ref": "#/definitions/position"
        },
        "fixes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/fix"
          }
        },
        "message": {
          "type": "string"
        },
        "path": {
          "description": "Analyzed source path; relative paths use the Action working directory.",
          "type": "string"
        },
        "rule": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "snippet": {
          "type": "string"
        },
        "start": {
          "$ref": "#/definitions/position"
        }
      }
    },
    "edit": {
      "type": "object",
      "required": [
        "end",
        "path",
        "replacement",
        "start"
      ],
      "properties": {
        "end": {
          "$ref": "#/definitions/position"
        },
        "path": {
          "type": "string"
        },
        "replacement": {
          "type": "string"
        },
        "start": {
          "$ref": "#/definitions/position"
        }
      }
    },
    "fix": {
      "type": "object",
      "required": [
        "description",
        "edits"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "edits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/edit"
          }
        }
      }
    },
    "origin": {
      "type": "object",
      "required": [
        "source",
        "state"
      ],
      "properties": {
        "column": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "input": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "source": {
          "type": "string"
        },
        "state": {
          "type": "string"
        }
      }
    },
    "position": {
      "description": "One-based line and Unicode character column. End positions are exclusive.",
      "type": "object",
      "required": [
        "column",
        "line"
      ],
      "properties": {
        "column": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "warning": {
      "type": "object",
      "required": [
        "column",
        "line",
        "message"
      ],
      "properties": {
        "column": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "line": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "message": {
          "type": "string"
        }
      }
    }
  },
  "title": "actionlint analysis result v1",
  "description": "Shared version 1 result for CLI JSON, Action JSON, and the Action result-file. Analysis status is independent of fail-on-error and optional reporting. Unknown properties are allowed for compatible additions. Diagnostic and edit end positions must not precede their starts; the runtime enforces this additional invariant.",
  "type": "object",
  "required": [
    "completed",
    "configurations",
    "diagnostics",
    "exit_code",
    "file_count",
    "hints",
    "schema_version",
    "status"
  ],
  "properties": {
    "completed": {
      "type": "boolean"
    },
    "configurations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/configuration"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/diagnostic"
      }
    },
    "error": {
      "type": "string"
    },
    "exit_code": {
      "enum": [
        0,
        1,
        2,
        3
      ]
    },
    "file_count": {
      "description": "Number of selected workflow files, or null when unknown. Zero means no workflows selected.",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "hints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sarif": {
      "description": "Optional SARIF report. Availability depends on the producer.",
      "type": "object",
      "required": [
        "runs",
        "version"
      ],
      "properties": {
        "runs": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "version": {
          "const": "2.1.0"
        }
      }
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "success",
        "problems-found",
        "invalid-options",
        "failure"
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "completed": {
          "const": true
        },
        "diagnostics": {
          "maxItems": 0
        },
        "exit_code": {
          "const": 0
        },
        "status": {
          "const": "success"
        }
      }
    },
    {
      "properties": {
        "completed": {
          "const": true
        },
        "diagnostics": {
          "minItems": 1
        },
        "exit_code": {
          "const": 1
        },
        "status": {
          "const": "problems-found"
        }
      }
    },
    {
      "properties": {
        "completed": {
          "const": false
        },
        "exit_code": {
          "const": 2
        },
        "status": {
          "const": "invalid-options"
        }
      }
    },
    {
      "properties": {
        "completed": {
          "const": false
        },
        "exit_code": {
          "const": 3
        },
        "status": {
          "const": "failure"
        }
      }
    }
  ]
}
